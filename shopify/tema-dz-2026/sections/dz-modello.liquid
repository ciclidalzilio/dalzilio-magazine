{%- comment -%}
  dz-modello.liquid — numeri chiave e banda immagine full-width del modello,
  come nell'anteprima. Taglie, colorazioni e rata vengono riempite da
  dz-prodotto.js leggendo le varianti già presenti in pagina.
{%- endcomment -%}

{%- liquid
  assign p = product

  comment
    Garanzia telaio per marca: Scott 5 anni, Trek e Cannondale a vita.
    Per gli altri marchi (es. Amflow) restiamo sul generico "Ufficiale".
  endcomment
  assign vmarca = p.vendor | downcase
  assign gar_telaio = 'Ufficiale'
  assign gar_frase = 'Garanzia ufficiale sul telaio, 2 anni sui componenti'
  if vmarca contains 'scott'
    assign gar_telaio = '5 anni'
    assign gar_frase = 'Garanzia di 5 anni sul telaio, 2 anni sui componenti'
  elsif vmarca contains 'trek' or vmarca contains 'cannondale'
    assign gar_telaio = 'A vita'
    assign gar_frase = 'Garanzia a vita sul telaio, 2 anni sui componenti'
  endif
-%}

{%- comment -%} sugli accessori e ricambi questa sezione non appare {%- endcomment -%}
{%- assign mostra_qui = true -%}
{%- if template contains 'product' and product -%}
  {%- capture bici_txt -%}{%- render 'dz-e-bici', product: product -%}{%- endcapture -%}
  {%- unless bici_txt contains 'si' -%}{%- assign mostra_qui = false -%}{%- endunless -%}
{%- endif -%}
{%- if mostra_qui -%}
<section class="dzs dzs-figs">
  <div class="dzs-in dzs-frow">
    <div class="dzs-fig"><b>{{ gar_telaio }}</b><span>Garanzia sul telaio</span></div>
    <div class="dzs-fig" data-dz-fig-colori-wrap><b data-dz-fig-colori>2 anni</b><span data-dz-fig-colori-label>Sui componenti</span></div>
    <div class="dzs-fig"><b data-dz-fig-taglie>{{ p.variants.size }}</b><span>Taglie</span></div>
    <div class="dzs-fig"><b><span data-dz-fig-rata>—</span><em>/mese</em></b><span>In <span data-dz-fig-mesi>48</span> rate</span></div>
  </div>
</section>

<section class="dzs dzs-feat dzs-auto">
  <div class="dzs-featimg dzs-studio">
    {%- assign foto2 = p.media[1] | default: p.featured_media -%}
    {%- if foto2 -%}
      <img src="{{ foto2 | image_url: width: 1400 }}" alt="{{ p.title | escape }}" loading="lazy">
    {%- endif -%}
    <span class="dzs-plate">{{ p.vendor | replace: 'scott_sports', 'SCOTT' }} · {{ 'now' | date: '%Y' }}</span>
  </div>
  <div class="dzs-feattxt">
    <p class="dzs-k">{{ section.settings.occhiello }}</p>
    <h2 class="dzs-h2f">Costruita per <b>durare oltre l'uscita di oggi.</b></h2>
    <p>
      {%- assign descr = p.description | strip_html | strip -%}
      {%- if descr != blank -%}
        {%- comment -%} il feed incolla il titolo all'inizio della descrizione {%- endcomment -%}
        {{ descr | remove_first: p.title | strip | truncate: 220 }}
      {%- else -%}
        Nuovo arrivo a catalogo: appena caricato dal feed ufficiale {{ p.vendor }}. Scrivici su WhatsApp per taglie, disponibilità e tempi di consegna.
      {%- endif -%}
    </p>
    <ul class="dzs-flist">
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>Montaggio e controllo pre-consegna nella nostra officina</li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>Regolazione di sella e posizione inclusa al ritiro</li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>{{ gar_frase }}</li>
    </ul>
  </div>
</section>
{%- endif -%}

{{ 'dz-sezioni.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "DZ · Il modello",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "occhiello", "label": "Occhiello", "default": "Il modello" }
  ],
  "presets": [{ "name": "DZ · Il modello" }]
}
{% endschema %}
