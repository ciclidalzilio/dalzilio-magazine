{%- comment -%}
  dz-scheda-prodotto.liquid — Cicli Dal Zilio

  Scheda prodotto: galleria con rail verticale, colonna acquisto che segue lo
  scorrimento, selettore taglia con le tabelle della casa madre, calcolatore
  rata e contatto WhatsApp.

  Non modifica alcun dato: taglia e colore sono ricavati dal titolo della
  variante, perché il catalogo Trek/Scott arriva dal feed automatico.

  Si aggiunge dal personalizzatore: Prodotto → Aggiungi sezione.
{%- endcomment -%}

{%- liquid
  assign p = product
  assign sconto = 0
  if p.compare_at_price > p.price
    assign diff = p.compare_at_price | minus: p.price | times: 100.0
    assign sconto = diff | divided_by: p.compare_at_price | round
  endif

  comment
    Su accessori e ricambi niente finanziamento, Klarna e servizi da bici.
  endcomment
-%}
{%- capture bici_txt -%}{%- render 'dz-e-bici', product: p -%}{%- endcapture -%}
{%- assign e_bici = false -%}
{%- if bici_txt contains 'si' -%}{%- assign e_bici = true -%}{%- endif -%}

<section class="dz" data-dz-prodotto>

  {%- comment -%} barra che resta fissa scorrendo: modello, prezzo, aggiungi {%- endcomment -%}
  <div class="dz-pdpbar" data-dz-pdpbar>
    <div class="dz-pdpbin">
      <span class="nm"><b>{{ p.title }}</b><span><span data-dz-bar-prezzo>{{ p.price | money }}</span>{% if e_bici %} · da <span data-dz-bar-rata></span>/mese{% endif %}</span></span>
      <button type="button" class="dz-btn dz-primary" data-dz-bar-add>Aggiungi al carrello</button>
    </div>
  </div>

  <div class="dz-wrap">

    {%- liquid
      comment
        Percorso: usa la collezione di provenienza; senza contesto (accesso
        diretto) sceglie la prima collezione "vera" della bici, saltando
        quelle di servizio (ultimi arrivi, promo, tutte le bici...).
      endcomment
      assign bc = collection
      if bc == blank
        for c in p.collections
          unless c.handle == 'new-arrivals' or c.handle == 'tutte-le-bici' or c.handle == 'promozioni' or c.handle == 'best-price' or c.handle == 'frontpage' or c.handle contains 'globofilter' or c.handle contains 'example'
            assign bc = c
            break
          endunless
        endfor
      endif
    -%}
    <nav class="dz-crumb" aria-label="Percorso">
      <a href="{{ routes.root_url }}">{{ 'nav.home' | t }}</a><span>/</span>
      {%- if bc != blank -%}<a href="{{ bc.url }}">{{ bc.title }}</a><span>/</span>{%- endif -%}
      <b>{{ p.title }}</b>
    </nav>

    <div class="dz-grid">

      {%- comment -%} ---------- galleria ---------- {%- endcomment -%}
      <div class="dz-gallery">
        <div class="dz-thumbs" data-dz-thumbs>
          {%- comment -%}
            Ogni miniatura elenca le varianti a cui appartiene: la foto
            principale di una variante, oppure un file il cui nome contiene il
            codice colore Scott (SKU a 13 cifre senza le ultime 3 di taglia).
            Le foto senza corrispondenza restano visibili per tutti i colori.
            Tutte le foto vengono elencate (una bici con 6 colori supera le 30).
          {%- endcomment -%}
          {%- for media in p.media limit: 80 -%}
            {%- assign nomefile = media.preview_image.src | split: '/' | last | split: '?' | first | downcase -%}
            {%- assign vids = '' -%}
            {%- for v in p.variants -%}
              {%- assign hit = false -%}
              {%- if v.featured_media and v.featured_media.id == media.id -%}{%- assign hit = true -%}{%- endif -%}
              {%- if hit == false and v.sku.size >= 10 -%}
                {%- assign lung = v.sku.size | minus: 3 -%}
                {%- assign pref = v.sku | slice: 0, lung | downcase -%}
                {%- if nomefile contains pref -%}{%- assign hit = true -%}{%- endif -%}
              {%- endif -%}
              {%- if hit -%}{%- assign vids = vids | append: v.id | append: ',' -%}{%- endif -%}
            {%- endfor -%}
            <button type="button" class="dz-thumb{% if forloop.first %} on{% endif %}"
                    data-dz-thumb="{{ forloop.index0 }}"
                    data-src="{{ media | image_url: width: 1400 }}"
                    data-varianti="{{ vids }}"
                    aria-label="Foto {{ forloop.index }}">
              <img src="{{ media | image_url: width: 200 }}" alt="" loading="lazy" width="82" height="70">
            </button>
          {%- endfor -%}
        </div>
        <div class="dz-main">
          {%- comment -%} nome del modello in filigrana dietro la bici (stile GT) {%- endcomment -%}
          {%- assign ghost = p.title | remove_first: 'Scott' | remove_first: 'SCOTT' | remove_first: 'Trek' | remove_first: 'TREK' | remove_first: 'Cannondale' | remove_first: 'CANNONDALE' | remove_first: 'Amflow' | remove_first: 'AMFLOW' | remove_first: 'Bicicletta' | strip -%}
          {%- if ghost == blank -%}{%- assign ghost = p.title -%}{%- endif -%}
          <span class="dz-ghost" aria-hidden="true">{{ ghost | escape | upcase }}</span>
          {%- if p.featured_media -%}
            <img id="dz-foto" src="{{ p.featured_media | image_url: width: 1400 }}"
                 alt="{{ p.featured_media.alt | escape }}" width="1400" height="1050">
          {%- else -%}
            <div class="dz-noimg">{{ 'general.image_placeholder' | t: default: 'Foto non disponibile' }}</div>
          {%- endif -%}
          <span class="dz-zoom">Clicca per lo zoom</span>
          <button type="button" class="dz-arrow prev" data-dz-prev aria-label="Foto precedente"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg></button>
          <button type="button" class="dz-arrow next" data-dz-next aria-label="Foto successiva"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg></button>
        </div>
      </div>

      {%- comment -%} ---------- colonna acquisto ---------- {%- endcomment -%}
      <div class="dz-info">
        {%- comment -%}
          Riconoscimento marca tollerante (maiuscole, suffissi tipo scott_sports).
          Niente loading="lazy": il logo parte nascosto e Chrome non caricherebbe
          mai un'immagine lazy invisibile.
        {%- endcomment -%}
        {%- assign vmin = p.vendor | downcase -%}
        {%- if vmin contains 'scott' -%}{%- assign marca_file = 'scott.png' -%}
        {%- elsif vmin contains 'trek' -%}{%- assign marca_file = 'trek.png' -%}
        {%- elsif vmin contains 'cannondale' -%}{%- assign marca_file = 'cnd.png' -%}
        {%- elsif vmin contains 'amflow' -%}{%- assign marca_file = 'amflow.png' -%}
        {%- else -%}{%- assign marca_file = p.vendor | handleize | append: '.png' -%}{%- endif -%}
        <div class="dz-brandrow">
          <img class="dz-brandlogo" src="{{ marca_file | file_url }}" alt="{{ p.vendor }}" loading="eager"
               onload="this.closest('.dz-brandrow').classList.add('ok')" onerror="this.remove()">
          <p class="dz-eye"><span class="dz-bn">{{ p.vendor | replace: 'scott_sports', 'SCOTT' }}{% if p.type != blank %} · {% endif %}</span>{{ p.type }}</p>
        </div>
        <h1 class="dz-title">{{ p.title }}</h1>
        {%- if p.type == 'USATO' and p.published_at -%}
          <p class="dz-pubdate">Annuncio pubblicato il {{ p.published_at | date: '%-d %B %Y' }}</p>
        {%- endif -%}

        <div class="dz-price{% if sconto > 0 %} sale{% endif %}">
          <b data-dz-prezzo>{{ p.price | money }}</b>
          {%- if sconto > 0 -%}
            <span class="dz-old" data-dz-listino>{{ p.compare_at_price | money }}</span>
            <span class="dz-off" data-dz-sconto>−{{ sconto }}%</span>
            {%- assign risparmio = p.compare_at_price | minus: p.price | money -%}
            <span class="dz-save">{{ 'prod.risparmi' | t: importo: risparmio }}</span>
          {%- endif -%}
          {%- if e_bici -%}<span class="dz-from">{{ 'prod.o_da' | t }} <b data-dz-rata>—</b>{{ 'prod.mese' | t }}</span>{%- endif -%}
        </div>

        {%- assign v0 = p.selected_or_first_available_variant -%}
        <p class="dz-codici">
          <span{% unless v0.sku != blank %} hidden{% endunless %}><b>SKU:</b> <span data-dz-sku>{{ v0.sku }}</span></span>
          <span{% unless v0.barcode != blank %} hidden{% endunless %}><b>EAN:</b> <span data-dz-ean>{{ v0.barcode }}</span></span>
        </p>

        {%- comment -%} numeri chiave dai metafield, se presenti {%- endcomment -%}
        {%- assign peso = p.metafields.specs.peso_kg -%}
        {%- assign rapporti = p.metafields.specs.rapporti -%}
        {%- if peso != blank or rapporti != blank -%}
          <div class="dz-figs">
            {%- if peso != blank -%}<div><b>{{ peso }} kg</b><span>{{ 'prod.peso' | t }}</span></div>{%- endif -%}
            {%- if rapporti != blank -%}<div><b>{{ rapporti }}</b><span>{{ 'prod.rapporti' | t }}</span></div>{%- endif -%}
            <div><b data-dz-ntaglie>—</b><span>{{ 'prod.taglie' | t }}</span></div>
          </div>
        {%- endif -%}

        {%- comment -%}
          Esaurita in tutte le taglie: il form resta nel DOM (il JS lo usa) ma
          nascosto; al suo posto un pannello "avvisami" + rimando alle simili.
        {%- endcomment -%}
        {%- unless p.available -%}
          <div class="dz-soldbox">
            <b>{{ 'prod.sold_t' | t }}</b>
            <p>{{ 'prod.sold_p' | t }}</p>
            {%- if section.settings.whatsapp != blank -%}
              <a class="dz-btn dz-primary" target="_blank" rel="noopener"
                 href="https://wa.me/{{ section.settings.whatsapp }}?text={{ 'prod.sold_msg' | t: titolo: p.title | url_encode }}">
                {{ 'prod.sold_wa' | t }}</a>
            {%- endif -%}
            <a class="dz-btn dz-sbghost" href="#dz-simili">{{ 'prod.sold_simili' | t }}</a>
          </div>
        {%- endunless -%}
        <form method="post" action="{{ routes.cart_add_url }}" id="dz-form" novalidate{% unless p.available %} hidden{% endunless %}>
          <input type="hidden" name="form_type" value="product">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}" data-dz-variante>

          <div class="dz-opt" data-dz-blocco-colore hidden>
            <div class="dz-opt-top"><span>{{ 'prod.colore' | t }}</span><span data-dz-colore-nome></span></div>
            <div class="dz-swatches" data-dz-colori></div>
          </div>

          <div class="dz-opt" data-dz-blocco-taglia hidden>
            <div class="dz-opt-top">
              <span>{{ 'prod.taglia' | t }}</span>
              <button type="button" class="dz-help" data-dz-apri-taglie>{{ 'prod.trova_taglia' | t }}</button>
            </div>

            <div class="dz-adv" data-dz-adv hidden>
              <label for="dz-altezza">{{ 'prod.alto' | t }}</label>
              <div class="dz-adv-row">
                <input type="number" id="dz-altezza" min="140" max="210" step="1" placeholder="es. 178">
                <span>cm</span>
                <button type="button" class="dz-btn dz-sm" data-dz-calcola>{{ 'prod.calcola' | t }}</button>
              </div>
              <p class="dz-adv-out" data-dz-adv-out></p>
              <p class="dz-adv-note">{{ 'prod.adv_note' | t }}</p>
            </div>

            <div class="dz-sizes" data-dz-taglie></div>
          </div>

          <noscript>
            <select name="id" style="width:100%;padding:12px;border-radius:12px;border:1px solid rgba(18,20,42,.18);margin-bottom:12px">
              {%- for v in p.variants -%}
                <option value="{{ v.id }}"{% unless v.available %} disabled{% endunless %}>
                  {{ v.title }} · {{ v.price | money }}{% unless v.available %} {{ 'prod.non_disp' | t }}{% endunless %}
                </option>
              {%- endfor -%}
            </select>
          </noscript>

          <div class="dz-buy">
            <div class="dz-qty">
              <button type="button" data-dz-q="-1" aria-label="{{ 'prod.diminuisci' | t }}">−</button>
              <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'prod.quantita' | t }}">
              <button type="button" data-dz-q="1" aria-label="{{ 'prod.aumenta' | t }}">+</button>
            </div>
            <button type="submit" class="dz-btn dz-primary" data-dz-aggiungi>
              {{ 'prod.aggiungi' | t }} · <span data-dz-prezzo-btn>{{ p.price | money }}</span>
            </button>
          </div>
        </form>

        {%- if p.available and section.settings.whatsapp != blank -%}
          <a class="dz-btn dz-wa" target="_blank" rel="noopener"
             href="https://wa.me/{{ section.settings.whatsapp }}?text={{ 'prod.wa_msg' | t: titolo: p.title | url_encode }}">
            {{ 'prod.wa_cta' | t }}
          </a>
        {%- endif -%}

        {% render 'dz-avviso-ferie' %}

        {%- if section.settings.tan > 0 and e_bici -%}
          <div class="dz-fin" data-dz-fin{% unless p.available %} hidden{% endunless %}
               data-prezzo="{{ p.price | divided_by: 100.0 }}"
               data-tan="{{ section.settings.tan }}"
               data-min="{{ section.settings.rate_min }}"
               data-max="{{ section.settings.rate_max }}"
               data-def="{{ section.settings.rate_def }}">
            <div class="dz-fin-top">
              <span>{{ 'prod.rate' | t }}</span>
              <span class="dz-tan">{{ 'prod.tan' | t: tan: section.settings.tan }}</span>
            </div>
            <div class="dz-fin-amt"><b data-dz-fin-rata>—</b><span>{{ 'prod.mese' | t }}</span></div>
            <p class="dz-fin-sub">{{ 'prod.rate_in' | t }} <b data-dz-fin-mesi>{{ section.settings.rate_def }}</b> {{ 'prod.rate_mensili' | t }}</p>
            <input type="range" data-dz-fin-range
                   min="{{ section.settings.rate_min }}" max="{{ section.settings.rate_max }}"
                   step="6" value="{{ section.settings.rate_def }}"
                   aria-label="{{ 'prod.fin_aria' | t }}">
            <div class="dz-fin-ticks">
              <span>{{ 'prod.mesi' | t: n: section.settings.rate_min }}</span><span>{{ 'prod.mesi' | t: n: section.settings.rate_max }}</span>
            </div>
            <p class="dz-fin-note">{{ section.settings.nota_fin }}</p>
          </div>
        {%- endif -%}

        {%- comment -%} Klarna 3 rate: possibile solo fino a 2.999 euro; oltre, niente cifra {%- endcomment -%}
        {%- if e_bici and p.available -%}
        <div class="dz-klarna" aria-label="{{ 'prod.klarna_aria' | t }}">
          <span class="dz-kb">Klarna.</span>
          {%- if p.price <= 299900 -%}
            {%- assign terzo = p.price | divided_by: 3 | money -%}<div><b>{{ 'prod.klarna_t' | t }}</b><span class="dz-ksub">{{ 'prod.klarna_sub' | t: importo: terzo }}</span></div>
          {%- else -%}
            <div><b>{{ 'prod.klarna_t' | t }}</b><span class="dz-ksub">{{ 'prod.klarna_over' | t }}</span></div>
          {%- endif -%}
        </div>
        {%- endif -%}

        {%- liquid
          assign sped = 'prod.sped_free' | t
          if e_bici == false and p.price < 9900
            assign sped = 'prod.sped_free99' | t
          endif
        -%}
        <div class="dz-trust">
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17.5" cy="18" r="1.6"/></svg>{{ sped }}</span>
          {%- if e_bici -%}
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/><circle cx="9" cy="7" r="2.1"/><circle cx="15" cy="12" r="2.1"/><circle cx="7" cy="17" r="2.1"/></svg>{{ section.settings.trust_2 }}</span>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8v8l9 5 9-5z"/><path d="M3 8l9 5 9-5M12 13v8"/></svg>{{ section.settings.trust_3 }}</span>
          {%- endif -%}
        </div>

        {%- if p.type == 'USATO' -%}
          {%- comment -%} checklist officina: toglie la paura dell'usato {%- endcomment -%}
          <div class="dz-usatochk">
            <div class="dz-uc-top">
              <span class="dz-uc-badge" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 12.5l5 5L19.5 7"/></svg></span>
              <div>
                <b>{{ 'prod.uc_t' | t }}</b>
                {%- assign uc_p = section.settings.usato_punti | default: 30 -%}<span>{{ 'prod.uc_sub' | t: punti: uc_p }}</span>
              </div>
            </div>
            <ul class="dz-uc-list">
              <li>{{ 'prod.uc_1' | t }}</li>
              <li>{{ 'prod.uc_2' | t }}</li>
              <li>{{ 'prod.uc_3' | t }}</li>
              <li>{{ 'prod.uc_4' | t }}</li>
              <li>{{ 'prod.uc_5' | t }}</li>
              <li>{{ 'prod.uc_6' | t }}</li>
            </ul>
          </div>
        {%- endif -%}

        <details class="dz-acc" open>
          <summary>{{ 'prod.desc' | t }}</summary>
          <div class="dz-acc-in">{{ p.description }}</div>
        </details>
        <details class="dz-acc">
          <summary>{{ 'prod.sped_resi' | t }}</summary>
          <div class="dz-acc-in">
            {%- if e_bici -%}
              {%- assign estero = 99 -%}
              {%- if p.title contains 'eRIDE' or p.title contains 'e-bike' or p.title contains 'E-bike' or p.title contains 'EXe' or p.title contains 'Rail' -%}{%- assign estero = 149 -%}{%- endif -%}
              {{ 'prod.sped_bici1' | t }}
              All'estero la spedizione parte da € {{ estero }} a seconda del modello.
              {{ 'prod.sped_bici2' | t }}
            {%- else -%}
              {{ 'prod.sped_acc' | t }}
            {%- endif -%}
          </div>
        </details>
        {%- if e_bici -%}
        <details class="dz-acc">
          <summary>{{ 'prod.garanzia' | t }}</summary>
          <div class="dz-acc-in">
            {%- if p.type == 'USATO' -%}
              {{ 'prod.gar_usato' | t }}
            {%- else -%}
              {%- if vmin contains 'scott' -%}
                {{ 'prod.gar_scott' | t }}
              {%- elsif vmin contains 'trek' or vmin contains 'cannondale' -%}
                {{ 'prod.gar_vita' | t }}
              {%- endif -%}
              {{ 'prod.gar_std' | t }}
            {%- endif -%}
          </div>
        </details>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%}
      Bici esaurita: proponi le gemelle davvero disponibili — stessa collezione
      di provenienza, prezzo entro ±35%. Se non ce ne sono, niente blocco.
    {%- endcomment -%}
    {%- unless p.available -%}
      {%- assign pmin = p.price | times: 0.65 -%}
      {%- assign pmax = p.price | times: 1.35 -%}
      {%- assign trovate = 0 -%}
      {%- capture simili_html -%}
        {%- if bc != blank -%}
          {%- for s in bc.products limit: 50 -%}
            {%- if trovate < 4 and s.available and s.id != p.id and s.featured_image and s.price >= pmin and s.price <= pmax -%}
              {% render 'dz-card', product: s %}
              {%- assign trovate = trovate | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endcapture -%}
      {%- if trovate > 0 -%}
        <div class="dz-simili" id="dz-simili">
          <div class="head"><div><p class="k">{{ 'prod.simili_k' | t }}</p><h2>{{ 'prod.simili_h' | t }}</h2></div>
            {%- if bc != blank -%}<a class="more" href="{{ bc.url }}">{{ 'prod.simili_all' | t }}</a>{%- endif -%}</div>
          <div class="prods">{{ simili_html }}</div>
        </div>
      {%- endif -%}
    {%- endunless -%}
  </div>

  {%- comment -%}
    Dati varianti per il JavaScript. La taglia è ricavata dal titolo:
    nessuna modifica al catalogo, il feed FTP resta intatto.
  {%- endcomment -%}
  {%- comment -%}
    Dati varianti per il JavaScript: solo campi semplici, nessuna elaborazione
    in Liquid. Taglia e colore vengono ricavati dal titolo lato browser, dove
    si possono usare le espressioni regolari. Nessun dato viene modificato.
  {%- endcomment -%}
  <script type="application/json" data-dz-varianti>
    [
    {%- for v in p.variants -%}
      {%- liquid
        assign taglia_vera = ''
        assign colore_vero = ''
        for opzione in p.options_with_values
          assign nome_opt = opzione.name | downcase
          assign k = forloop.index0
          if nome_opt == 'taglia' or nome_opt == 'size'
            assign taglia_vera = v.options[k]
          endif
          if nome_opt == 'colore' or nome_opt == 'color' or nome_opt == 'colour'
            assign colore_vero = v.options[k]
          endif
        endfor
      -%}
      {"id": {{ v.id }},
       "titolo": {{ v.title | json }},
       "taglia_vera": {{ taglia_vera | json }},
       "colore_vero": {{ colore_vero | json }},
       "disponibile": {{ v.available | json }},
       "prezzo": {{ v.price | divided_by: 100.0 }},
       "listino": {{ v.compare_at_price | default: 0 | divided_by: 100.0 }},
       "sku": {{ v.sku | json }},
       "ean": {{ v.barcode | json }},
       "foto": {% if v.featured_media %}{{ v.featured_media | image_url: width: 1400 | json }}{% else %}""{% endif %},
       "prezzo_html": {{ v.price | money | json }}}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
    ]
  </script>

  <script type="application/json" data-dz-prodotto-nome>{{ p.title | json }}</script>
  <script type="application/json" data-dz-tabelle-taglie>{{ section.settings.tabelle_taglie }}</script>
</section>

<div class="dz-zoombox" data-dz-zoombox>
  <img alt="">
  <button type="button" class="dz-zclose" aria-label="Chiudi lo zoom">✕</button>
</div>

{{ 'dz-prodotto.css' | asset_url | stylesheet_tag }}
{{ 'dz-galleria.css' | asset_url | stylesheet_tag }}
<script src="{{ 'dz-prodotto.js' | asset_url }}" defer></script>
<script src="{{ 'dz-galleria.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "DZ · Scheda prodotto",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Finanziamento" },
    { "type": "number", "id": "tan", "label": "TAN fisso (%). 0 per nascondere il riquadro", "default": 6 },
