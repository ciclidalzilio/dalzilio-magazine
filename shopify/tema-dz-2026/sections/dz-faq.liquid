{%- comment -%}
  dz-faq.liquid — le domande frequenti, riprese dal sito attuale.
  Le voci si modificano dal personalizzatore (blocchi); qui sotto ci sono
  i default già compilati con i testi reali.
{%- endcomment -%}

{%- comment -%} sugli accessori e ricambi questa sezione non appare {%- endcomment -%}
{%- assign mostra_qui = true -%}
{%- if template contains 'product' and product -%}
  {%- capture bici_txt -%}{%- render 'dz-e-bici', product: product -%}{%- endcapture -%}
  {%- unless bici_txt contains 'si' -%}{%- assign mostra_qui = false -%}{%- endunless -%}
{%- endif -%}
{%- if mostra_qui -%}
<section class="block wrap dz-faq">
  <div class="head"><div><p class="k">{{ section.settings.occhiello }}</p><h2>{{ section.settings.titolo }}</h2></div></div>
  <div class="faqlist">
    {%- for block in section.blocks -%}
      <details {{ block.shopify_attributes }}{% if forloop.first and section.settings.prima_aperta %} open{% endif %}>
        <summary>{{ block.settings.domanda }}</summary>
        <p>{{ block.settings.risposta }}</p>
      </details>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "DZ · FAQ",
  "settings": [
    { "type": "text", "id": "occhiello", "label": "Occhiello", "default": "FAQ" },
    { "type": "text", "id": "titolo", "label": "Titolo", "default": "Tutto quello che devi sapere prima dell'acquisto" },
    { "type": "checkbox", "id": "prima_aperta", "label": "Prima domanda aperta", "default": false }
  ],
  "blocks": [
    {
      "type": "voce",
      "name": "Domanda",
      "settings": [
        { "type": "text", "id": "domanda", "label": "Domanda" },
        { "type": "textarea", "id": "risposta", "label": "Risposta" }
      ]
    }
  ],
  "presets": [
    {
      "name": "DZ · FAQ",
      "blocks": [
        { "type": "voce", "settings": { "domanda": "La bicicletta viene consegnata già assemblata?", "risposta": "Sì. Ogni bicicletta viene controllata e preparata dal nostro staff specializzato prima della spedizione. La bici viene consegnata pre-assemblata e pronta per essere completata con poche e semplici operazioni, che possono variare in base al modello e alle esigenze di trasporto." } },
        { "type": "voce", "settings": { "domanda": "Come posso scegliere la taglia corretta?", "risposta": "La scelta della taglia dipende da altezza, cavallo, proporzioni corporee e stile di guida. Se hai dubbi, contattaci prima dell'acquisto indicando la tua altezza e la misura del cavallo: il nostro staff ti aiuterà a individuare la taglia più adatta." } },
        { "type": "voce", "settings": { "domanda": "La bicicletta è coperta da garanzia?", "risposta": "Sì. Tutti i prodotti nuovi sono coperti dalla garanzia prevista dal produttore e dalla normativa applicabile. In caso di necessità, il nostro staff ti assisterà nella gestione della richiesta e nei rapporti con il produttore." } },
        { "type": "voce", "settings": { "domanda": "Quali sono i tempi di spedizione?", "risposta": "I tempi possono variare in base alla disponibilità del prodotto e alla destinazione. Le biciclette disponibili vengono preparate con cura dal nostro staff prima della partenza. Dopo la spedizione riceverai le informazioni necessarie per seguire la consegna." } },
        { "type": "voce", "settings": { "domanda": "Spedite anche all'estero?", "risposta": "Sì, effettuiamo spedizioni in Italia e in numerosi Paesi europei. Costi e modalità di consegna possono variare in base alla destinazione e alle dimensioni del prodotto." } },
        { "type": "voce", "settings": { "domanda": "Posso acquistare senza IVA con una partita IVA europea?", "risposta": "Per i clienti aziendali con partita IVA valida in un altro Paese dell'Unione Europea possono essere applicate le condizioni fiscali previste per le operazioni intracomunitarie. Contattaci prima dell'acquisto indicando i dati completi dell'azienda e la partita IVA: verificheremo la possibilità di procedere secondo la normativa applicabile." } },
        { "type": "voce", "settings": { "domanda": "È possibile pagare a rate?", "risposta": "Quando disponibile, puoi scegliere una delle soluzioni di pagamento rateale mostrate direttamente durante il checkout. La disponibilità e l'approvazione del pagamento dipendono dal servizio selezionato e dalle relative condizioni." } },
        { "type": "voce", "settings": { "domanda": "Posso restituire il prodotto?", "risposta": "Puoi richiedere un reso secondo le condizioni e i termini indicati nella nostra politica di reso. Il prodotto dovrà rispettare i requisiti previsti e dovrà essere restituito nelle condizioni indicate. Ti consigliamo di consultare la pagina dedicata prima di procedere con la richiesta." } },
        { "type": "voce", "settings": { "domanda": "Il prodotto che vedo online è realmente disponibile?", "risposta": "La disponibilità mostrata sul sito viene aggiornata regolarmente. Per prodotti particolarmente richiesti o per ordini urgenti, puoi contattarci prima dell'acquisto per una verifica diretta della disponibilità." } }
      ]
    }
  ]
}
{% endschema %}
