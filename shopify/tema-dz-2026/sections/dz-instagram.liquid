{%- comment -%}
  dz-instagram.liquid — banda "Seguici su Instagram" + spazio per il feed.
  Il feed vero è il blocco dell'app Instafeed (già installata): si aggiunge
  dal personalizzatore dentro questa sezione (blocco "App").
{%- endcomment -%}

<section class="dz-ig">
  <a class="dz-ig-band" href="https://www.instagram.com/ciclidalzilio/" target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" aria-hidden="true"><defs><linearGradient id="dzig" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#FFDC80"/><stop offset=".5" stop-color="#F77737"/><stop offset=".75" stop-color="#E1306C"/><stop offset="1" stop-color="#833AB4"/></linearGradient></defs><path fill="url(#dzig)" d="M7.75 2h8.5A5.76 5.76 0 0 1 22 7.75v8.5A5.76 5.76 0 0 1 16.25 22h-8.5A5.76 5.76 0 0 1 2 16.25v-8.5A5.76 5.76 0 0 1 7.75 2Zm0 2A3.75 3.75 0 0 0 4 7.75v8.5A3.75 3.75 0 0 0 7.75 20h8.5A3.75 3.75 0 0 0 20 16.25v-8.5A3.75 3.75 0 0 0 16.25 4h-8.5ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm5.25-3.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5Z"/></svg>
    <span>Seguici su Instagram <strong>@ciclidalzilio</strong></span>
  </a>
  {%- for block in section.blocks -%}
    <div {{ block.shopify_attributes }}>{% render block %}</div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "DZ · Instagram",
  "settings": [],
  "blocks": [ { "type": "@app" } ],
  "presets": [ { "name": "DZ · Instagram" } ]
}
{% endschema %}
