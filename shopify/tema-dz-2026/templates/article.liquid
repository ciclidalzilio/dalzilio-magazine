{%- comment -%} Articolo del blog — DZ 2026 {%- endcomment -%}
<div class="wrap">
  <nav class="crumb"><a href="{{ routes.root_url }}">{{ 'nav.home' | t }}</a><span>/</span><a href="{{ blog.url }}">{{ blog.title }}</a><span>/</span><b>{{ article.title | truncate: 40 }}</b></nav>

  <article class="art">
    <header class="art-head">
      <p class="art-k">{{ blog.title }}{% if article.tags.size > 0 %} · {{ article.tags.first }}{% endif %}</p>
      <h1>{{ article.title }}</h1>
      <p class="art-meta">{{ article.published_at | date: '%-d %B %Y' }}{% if article.author != blank %} · {{ 'blog.di' | t }} {{ article.author }}{% endif %}</p>
    </header>

    {%- if article.image -%}
      <div class="art-cover"><img src="{{ article.image | image_url: width: 1600 }}" alt="{{ article.image.alt | default: article.title | escape }}" width="1600"></div>
    {%- endif -%}

    <div class="art-body">{{ article.content }}</div>

    <footer class="art-foot">
      <a class="btn ghost sm" href="{{ blog.url }}">{{ 'blog.tutti' | t }}</a>
      <a class="btn sm" href="https://wa.me/393457815102?text={{ 'blog.wa_msg' | t: titolo: article.title | url_encode }}">{{ 'blog.chiedi' | t }}</a>
    </footer>
  </article>

  {%- assign altri = 0 -%}
  {%- for a in blog.articles limit: 4 -%}
    {%- if a.id != article.id -%}{%- assign altri = altri | plus: 1 -%}{%- endif -%}
  {%- endfor -%}
  {%- if altri > 0 -%}
    <aside class="art-more">
      <div class="head"><div><p class="k">{{ 'blog.dal_blog' | t }}</p><h2>{{ 'blog.altri' | t }}</h2></div></div>
      <div class="bloggrid">
        {%- assign mostrati = 0 -%}
        {%- for a in blog.articles limit: 6 -%}
          {%- if a.id != article.id and mostrati < 3 -%}
            {%- assign mostrati = mostrati | plus: 1 -%}
            <a class="bcard" href="{{ a.url }}">
              {%- if a.image -%}<span class="bimg"><img src="{{ a.image | image_url: width: 640 }}" alt="" loading="lazy"></span>{%- endif -%}
              <span class="bdate">{{ a.published_at | date: '%-d %B %Y' }}</span>
              <h3>{{ a.title }}</h3>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </aside>
  {%- endif -%}
</div>
<div style="height:50px"></div>

{% style %}
  .art{max-width:760px;margin:0 auto}
  .art-head{text-align:center;padding:22px 0 6px}
  .art-k{font-family:var(--font-mono);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--rose);margin:0 0 12px}
  .art-head h1{font-size:clamp(1.9rem,4.4vw,3rem);letter-spacing:-.035em;font-weight:740;line-height:1.08;margin:0 0 12px;text-wrap:balance}
  .art-meta{font-family:var(--font-mono);font-size:11.5px;letter-spacing:.06em;color:var(--muted-2);margin:0}
  .art-cover{margin:26px 0 0;border-radius:18px;overflow:hidden;border:1px solid var(--line)}
  .art-cover img{width:100%;height:auto;display:block}
  .art-body{padding:30px 0 8px;font-size:16.5px;line-height:1.75;color:var(--ink-2)}
  .art-body p{margin:0 0 1.2em}
  .art-body h2{font-size:1.5rem;letter-spacing:-.025em;margin:1.6em 0 .5em}
  .art-body h3{font-size:1.2rem;letter-spacing:-.02em;margin:1.4em 0 .4em}
  .art-body img{max-width:100%;height:auto;border-radius:14px;margin:10px 0}
  .art-body a{text-decoration:underline;text-underline-offset:3px}
  .art-body blockquote{margin:1.4em 0;padding:4px 0 4px 18px;border-left:3px solid var(--rose);color:var(--muted);font-style:italic}
  .art-body ul,.art-body ol{padding-left:1.3em;margin:0 0 1.2em}
  .art-foot{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;border-top:1px solid var(--line);padding:22px 0 0;margin-top:10px}
  .art-more{padding-top:56px}
{% endstyle %}
