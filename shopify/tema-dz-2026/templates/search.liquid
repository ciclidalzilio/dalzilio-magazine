{%- comment -%}
  Ricerca DZ 2026 — stessi filtri nativi delle collezioni (Search & Discovery):
  colonna filtri, etichette attive rimovibili, ordinamento e paginazione.
{%- endcomment -%}
<div class="wrap">
  <nav class="crumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><b>Ricerca</b></nav>
  <div class="ltop">
    <div><h1>Cerca nel catalogo</h1>
      {%- if search.performed -%}<div class="sub">{{ search.results_count }} risultat{% if search.results_count == 1 %}o{% else %}i{% endif %} per “{{ search.terms | escape }}”</div>{%- endif -%}
    </div>
    {%- if search.performed -%}
      <select class="sortsel" onchange="location.href=this.value">
        {%- assign term_enc = search.terms | url_encode -%}
        {%- assign base = routes.search_url | append: '?q=' | append: term_enc | append: '&type=product&sort_by=' -%}
        <option value="{{ base }}relevance" {% if search.sort_by == 'relevance' or search.sort_by == blank %}selected{% endif %}>Ordina: Rilevanza</option>
        <option value="{{ base }}price-ascending" {% if search.sort_by == 'price-ascending' %}selected{% endif %}>Prezzo crescente</option>
        <option value="{{ base }}price-descending" {% if search.sort_by == 'price-descending' %}selected{% endif %}>Prezzo decrescente</option>
      </select>
    {%- endif -%}
  </div>
  <form action="{{ routes.search_url }}" method="get" class="nform sform" style="justify-content:flex-start;margin:0 0 26px">
    <div class="sbox">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Es. Domane, e-bike, casco…" aria-label="Cerca prodotti" autocomplete="off" {% unless search.performed %}autofocus{% endunless %} data-dz-sugg-input>
      <div class="sugg" data-dz-sugg hidden></div>
    </div>
    <input type="hidden" name="type" value="product">
    <button class="btn" type="submit">Cerca</button>
  </form>

  {%- if search.performed -%}
    {%- comment -%} filtri attivi, rimovibili con un tocco {%- endcomment -%}
    {%- assign attivi = 0 -%}
    {%- for filter in search.filters -%}
      {%- assign attivi = attivi | plus: filter.active_values.size -%}
      {%- if filter.type == 'price_range' and filter.min_value.value != blank -%}{%- assign attivi = attivi | plus: 1 -%}{%- endif -%}
    {%- endfor -%}
    {%- if attivi > 0 -%}
      <div class="fattivi">
        {%- for filter in search.filters -%}
          {%- for v in filter.active_values -%}<a href="{{ v.url_to_remove }}">{{ v.label }}</a>{%- endfor -%}
          {%- if filter.type == 'price_range' and filter.min_value.value != blank or filter.max_value.value != blank -%}
            <a href="{{ filter.url_to_remove }}">Prezzo</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="listwrap{% if search.filters == blank or search.filters.size == 0 %} nofiltri{% endif %}">
      {%- if search.filters.size > 0 -%}
        <form class="filters" method="get" action="{{ routes.search_url }}">
          <input type="hidden" name="q" value="{{ search.terms | escape }}">
          <input type="hidden" name="type" value="product">
          {%- if search.sort_by != blank -%}<input type="hidden" name="sort_by" value="{{ search.sort_by }}">{%- endif -%}
          <h4>Filtri</h4>
          {%- for filter in search.filters -%}
            {%- liquid
              comment
                Aperti di default: Brand e Prezzo, piu' qualunque gruppo con un filtro attivo.
              endcomment
              assign f_label = filter.label | downcase
              assign f_open = false
              if filter.active_values.size > 0
                assign f_open = true
              elsif filter.type == 'price_range'
                assign f_open = true
              elsif f_label contains 'brand' or f_label contains 'marca'
                assign f_open = true
              endif
            -%}
            <details {% if f_open %}open{% endif %}>
              <summary>{{ filter.label }}</summary>
              {%- case filter.type -%}
                {%- when 'price_range' -%}
                  <div class="fprice">
                    <input type="number" name="{{ filter.min_value.param_name }}" placeholder="Da €"
                           {% if filter.min_value.value %}value="{{ filter.min_value.value | money_without_currency | replace: ',', '.' }}"{% endif %} min="0">
                    <input type="number" name="{{ filter.max_value.param_name }}" placeholder="A €"
                           {% if filter.max_value.value %}value="{{ filter.max_value.value | money_without_currency | replace: ',', '.' }}"{% endif %} min="0">
                  </div>
                {%- else -%}
                  {%- for v in filter.values limit: 14 -%}
                    <label class="fopt">
                      <input type="checkbox" name="{{ v.param_name }}" value="{{ v.value }}"
                             {% if v.active %}checked{% endif %} {% if v.count == 0 and v.active == false %}disabled{% endif %}>
                      {{ v.label }}<span class="n">{{ v.count }}</span>
                    </label>
                  {%- endfor -%}
              {%- endcase -%}
            </details>
          {%- endfor -%}
          <button class="btn sm block" type="submit" style="margin-top:14px">Applica filtri</button>
          {%- if attivi > 0 -%}<a class="btn ghost sm block" style="margin-top:8px" href="{{ routes.search_url }}?q={{ search.terms | url_encode }}&type=product">Azzera</a>{%- endif -%}
        </form>
      {%- endif -%}

      <div>
        {%- paginate search.results by 24 -%}
          <div class="listgrid">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}{% render 'dz-card', product: item %}{%- endif -%}
            {%- else -%}
              <p style="grid-column:1/-1;color:var(--muted);padding:40px 0">Nessun risultato. Prova con un altro termine o <a href="/collections/tutte-le-bici" style="text-decoration:underline">sfoglia il catalogo</a>.</p>
            {%- endfor -%}
          </div>
          {%- if paginate.pages > 1 -%}
            <nav class="pagin">
              {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">←</a>{%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
                {%- elsif part.title == paginate.current_page -%}<span class="cur">{{ part.title }}</span>
                {%- else -%}<span>{{ part.title }}</span>{%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}<a href="{{ paginate.next.url }}">→</a>{%- endif -%}
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
    </div>
  {%- endif -%}
</div>
<div style="height:40px"></div>

{% style %}
  .sform .sbox{position:relative;flex:0 1 auto;width:min(420px,100%)}
  .sform .sbox input[type="search"]{width:100%;min-width:0!important}
  .sugg{position:absolute;left:0;right:0;top:calc(100% + 8px);z-index:60;background:var(--surface);
    border:1px solid var(--line-strong);border-radius:16px;box-shadow:0 24px 60px -24px rgba(18,20,42,.35);
    overflow:hidden;max-height:min(430px,60vh);overflow-y:auto}
  .sugg a{display:flex;align-items:center;gap:12px;padding:10px 14px;border-bottom:1px solid var(--line)}
  .sugg a:hover{background:rgba(18,20,42,.04)}
  .sugg img{width:52px;height:40px;object-fit:contain;background:#fff;border-radius:8px;flex:0 0 52px}
  .sugg .st{min-width:0}
  .sugg .st b{display:block;font-size:13.5px;font-weight:620;letter-spacing:-.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .sugg .st span{font-size:12px;color:var(--muted)}
  .sugg .tutti{justify-content:center;font-size:13px;font-weight:650;color:var(--rose);border-bottom:0;padding:12px}
  .sugg .vuoto{padding:14px;font-size:13px;color:var(--muted);text-align:center}
{% endstyle %}

<script>
  /* suggerimenti live dalla ricerca predittiva di Shopify */
  (function () {
    var input = document.querySelector("[data-dz-sugg-input]");
    var box = document.querySelector("[data-dz-sugg]");
    if (!input || !box) return;
    var timer = null, ultimo = "";

    function money(v) {
      var n = parseFloat(v);
      if (isNaN(n)) return "";
      return "€ " + n.toLocaleString("it-IT", { minimumFractionDigits: 0, maximumFractionDigits: 0 });
    }
    function chiudi() { box.hidden = true; box.innerHTML = ""; }

    function mostra(q, prodotti) {
      if (!prodotti.length) {
        box.innerHTML = '<div class="vuoto">Nessun suggerimento per “' + q.replace(/</g, "&lt;") + '”</div>';
        box.hidden = false;
        return;
      }
      var html = prodotti.map(function (p) {
        var img = p.featured_image && p.featured_image.url
          ? '<img src="' + p.featured_image.url.replace(/(\.[a-z]+)(\?|$)/, "_120x$1$2") + '" alt="" loading="lazy">'
          : '<span style="width:52px;height:40px;flex:0 0 52px"></span>';
        return '<a href="' + p.url + '">' + img +
          '<span class="st"><b>' + p.title + '</b><span>' + (p.vendor || "") +
          (p.price ? " · " + money(p.price) : "") + '</span></span></a>';
      }).join("");
      html += '<a class="tutti" href="{{ routes.search_url }}?q=' + encodeURIComponent(q) + '&type=product">Tutti i risultati per “' + q.replace(/</g, "&lt;") + '” →</a>';
      box.innerHTML = html;
      box.hidden = false;
    }

    input.addEventListener("input", function () {
      var q = input.value.trim();
      clearTimeout(timer);
      if (q.length < 2) { chiudi(); return; }
      timer = setTimeout(function () {
        ultimo = q;
        fetch("{{ routes.predictive_search_url }}?q=" + encodeURIComponent(q) +
              "&resources[type]=product&resources[limit]=8&resources[options][unavailable_products]=last&section_id=")
          .then(function (r) { return r.json(); })
          .then(function (j) {
            if (q !== ultimo) return;
            var prodotti = (j.resources && j.resources.results && j.resources.results.products) || [];
            mostra(q, prodotti);
          })
          .catch(chiudi);
      }, 220);
    });
    document.addEventListener("click", function (e) {
      if (!e.target.closest(".sbox")) chiudi();
    });
    input.addEventListener("keydown", function (e) {
      if (e.key === "Escape") chiudi();
    });
  })();
</script>
