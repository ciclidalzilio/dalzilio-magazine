      <p style="color:var(--ok);font-weight:600;width:100%">{{ 'home.news_ok' | t }}</p>
    {%- else -%}
      <input type="email" name="contact[email]" placeholder="{{ 'home.news_ph' | t }}" aria-label="{{ 'home.news_ph' | t }}" required>
      <button class="btn" type="submit">{{ 'home.news_btn' | t }}</button>
