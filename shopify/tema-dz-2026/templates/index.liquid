{%- comment -%}
  Home DZ 2026 — apertura scenografica (DAL ZILIO), marchi, categorie, ultimi arrivi (dalla
  collezione new-arrivals), usato reale, permuta (solo verso il nuovo), rate.
  Tutto legge dalle collezioni esistenti: nessun dato inventato.
{%- endcomment -%}

<section class="dzh" data-dzh>
  {%- comment -%}
    Apertura scenografica (stili in dz-apertura.css). La parola DAL ZILIO e'
    scritta due volte con lo stesso ciclo: una copia fa da maschera sopra la
    foto, l'altra porta il riflesso. La I di ZILIO (data-dzh-o) e' il punto in
    cui si "entra" scorrendo. Titolo h1, pulsanti e numeri restano nel codice
    della pagina anche prima di comparire.
  {%- endcomment -%}
  {%- assign anno_c = 'now' | date: '%Y' -%}
  {%- case request.locale.iso_code -%}
    {%- when 'en' -%}{%- assign scorri = 'Scroll' -%}
    {%- when 'de' -%}{%- assign scorri = 'Scrollen' -%}
    {%- when 'fr' -%}{%- assign scorri = 'Défiler' -%}
    {%- else -%}{%- assign scorri = 'Scorri' -%}
  {%- endcase -%}
  {%- capture parola -%}
    <span class="dzh-parola">
      {%- assign righe = 'DAL,ZILIO' | split: ',' -%}
      {%- assign n = 0 -%}
      {%- for riga in righe -%}
        {%- assign lettere = riga | split: '' -%}
        <span class="dzh-riga">
          {%- for x in lettere -%}
            <span class="dzh-l" style="--d:{{ n }}"{% if forloop.parentloop.index == 2 and forloop.index == 2 %} data-dzh-o{% endif %}>{{ x }}</span>
            {%- assign n = n | plus: 1 -%}
          {%- endfor -%}
        </span>{% unless forloop.last %} {% endunless %}
      {%- endfor -%}
    </span>
  {%- endcapture -%}
  <div class="dzh-stage">
    <div class="dzh-foto" aria-hidden="true">
      <img src="{{ 'hero-corsa.jpg' | asset_url }}" alt="" width="1600" height="685" fetchpriority="high">
    </div>
    <div class="dzh-velo" aria-hidden="true"></div>
    <div class="dzh-maschera" aria-hidden="true">{{ parola }}</div>
    <div class="dzh-luce" aria-hidden="true">{{ parola | remove: ' data-dzh-o' }}</div>
    <div class="dzh-intro">
      <p class="dzh-k" aria-hidden="true">{{ 'home.kicker' | t: anno: anno_c }}</p>
      <button class="dzh-giu-cue" type="button" data-dzh-cue>{{ scorri }}<i aria-hidden="true"></i></button>
    </div>
    <div class="wrap dzh-testo">
      <div class="dzh-su">
        <p class="dzh-k">{{ 'home.kicker' | t: anno: anno_c }}</p>
        <h1>{{ 'home.h1a' | t }} <span class="g">{{ 'home.h1b' | t }}</span></h1>
        <p class="dzh-lede">{{ 'home.lede' | t }}</p>
      </div>
      <div class="dzh-giu">
        <div class="dzh-cta">
          <a class="btn" href="/collections/tutte-le-bici">{{ 'home.cta_catalogo' | t }}</a>
          <a class="btn ghost" href="#bike-finder">{{ 'home.cta_finder' | t }}</a>
          <a class="btn ghost" href="/collections/new-arrivals">{{ 'home.cta_arrivi' | t }}</a>
        </div>
        <div class="dzh-num">
          <div><b>{{ collections['tutte-le-bici'].products_count | default: '350+' }}</b><span>{{ 'home.stat_bici' | t }}</span></div>
          <div><b>{{ 'home.stat_brand_v' | t }}</b><span>{{ 'home.stat_brand_l' | t }}</span></div>
          <div><b>{{ 'home.stat_off_v' | t }}</b><span>{{ 'home.stat_off_l' | t }}</span></div>
        </div>
      </div>
    </div>
  </div>
  <script>
    (function(){
      var sec = document.querySelector('[data-dzh]'); if (!sec) return;
      var st = sec.querySelector('.dzh-stage'), o = sec.querySelector('[data-dzh-o]');
      var fascia = document.querySelector('.brands-dark'), testa = document.querySelector('.dz header');
      var fermo = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* menu scuro finche' sotto di lui c'e' l'apertura o la fascia nera dei marchi */
      function buio(){
        var lim = testa ? testa.getBoundingClientRect().bottom : 66;
        var fine = (fascia || sec).getBoundingClientRect().bottom;
        document.body.classList.toggle('dz-buio', fine > lim);
      }
      if (fermo) { buio(); addEventListener('scroll', buio, { passive: true }); return; }
      sec.classList.add('dzh-js');

      function cl(t){ return t < 0 ? 0 : t > 1 ? 1 : t; }
      function morbido(t){ return t * t * (3 - 2 * t); }
      function v(k, x){ st.style.setProperty(k, x); }

      /* punto d'ingresso: il centro della I, misurato sulla parola senza zoom */
      function origine(){
        if (!o) return;
        v('--ox', (o.offsetLeft + o.offsetWidth / 2) + 'px');
        v('--oy', (o.offsetTop + o.offsetHeight * 0.5) + 'px');
      }
      function corsa(){ return Math.max(1, sec.offsetHeight - st.offsetHeight); }

      var S = 40;
      function disegna(){
        var p = cl(-sec.getBoundingClientRect().top / corsa());
        var t = morbido(cl(p / 0.62));
        v('--s', Math.exp(Math.log(S) * t).toFixed(4));
        v('--m', (1 - cl((p - 0.4) / 0.2)).toFixed(3));
        v('--i', (1 - cl(p / 0.14)).toFixed(3));
        v('--z', (1.22 - 0.22 * t).toFixed(4));
        var c = morbido(cl((p - 0.48) / 0.3)), c2 = morbido(cl((p - 0.6) / 0.3));
        v('--c', c.toFixed(3)); v('--c2', c2.toFixed(3));
        sec.classList.toggle('dzh-pronto', c > 0.6);
        buio();
      }
      var att = false;
      function chiedi(){ if (!att) { att = true; requestAnimationFrame(function(){ att = false; disegna(); }); } }
      addEventListener('scroll', chiedi, { passive: true });
      addEventListener('resize', function(){ origine(); chiedi(); });
      origine(); disegna();
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(function(){ origine(); disegna(); });
      setTimeout(origine, 1500);

      /* "Scorri" porta alla fine della sequenza; idem se si arriva ai pulsanti con la tastiera */
      function allaFine(){ scrollTo({ top: sec.getBoundingClientRect().top + scrollY + corsa(), behavior: 'smooth' }); }
      var cue = sec.querySelector('[data-dzh-cue]'); if (cue) cue.addEventListener('click', allaFine);
      sec.querySelector('.dzh-testo').addEventListener('focusin', function(){ if (!sec.classList.contains('dzh-pronto')) allaFine(); });

      /* la foto segue appena il mouse */
      if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
        var tx = 0, ty = 0, cx = 0, cy = 0, gira = false;
        st.addEventListener('mousemove', function(e){
          var r = st.getBoundingClientRect();
          tx = ((e.clientX - r.left) / r.width - 0.5) * -22; ty = ((e.clientY - r.top) / r.height - 0.5) * -14;
          if (!gira) { gira = true; requestAnimationFrame(passo); }
        });
        function passo(){
          cx += (tx - cx) * 0.08; cy += (ty - cy) * 0.08;
          v('--px', cx.toFixed(2) + 'px'); v('--py', cy.toFixed(2) + 'px');
          if (Math.abs(tx - cx) > 0.1 || Math.abs(ty - cy) > 0.1) requestAnimationFrame(passo); else gira = false;
        }
      }
    })();
  </script>
</section>

<section class="brands-dark" data-bd>
  {%- comment -%}
    I marchi, stile Apple: banda nera da bordo a bordo, solo i quattro loghi,
    enormi e in bianco. Si accendono uno dopo l'altro quando la fascia entra
    nello schermo; un riflesso di luce attraversa ogni logo (il logo e' doppio:
    la copia sopra viene ritagliata da una fascia che scorre); dietro, un
    fascio di luce che si muove piano. Nessun testo oltre l'etichetta.
    I loghi sono i PNG del negozio: invertiti e fusi in "screen" restano
    bianchi sia con sfondo trasparente sia con sfondo bianco.
  {%- endcomment -%}
  {%- comment -%} ultimo campo: scala del logo. Il PNG Amflow (1400x800) ha molta aria attorno: a pari altezza esce piccolo {%- endcomment -%}
  {%- assign marchi = 'trek|TREK|trek.png|1,scott|SCOTT|scott.png|1,cannondale|CANNONDALE|cnd.png|1,amflow|AMFLOW|amflow.png|1.6' | split: ',' -%}
  <i class="bd-beam" aria-hidden="true"></i>
  <div class="wrap">
    <p class="bd-k">{{ 'home.loghi' | t }}</p>
    <div class="bd-row">
      {%- for riga in marchi -%}
        {%- assign c = riga | split: '|' -%}
        <a class="bd-cell" href="/pages/{{ c[0] }}" style="--i:{{ forloop.index0 }};--s:{{ c[3] }}">
          <span class="bd-l">
            <img class="bd-logo" src="{{ c[2] | file_url }}" alt="{{ c[1] }}" loading="lazy">
            <img class="bd-logo bd-glint" src="{{ c[2] | file_url }}" alt="" aria-hidden="true" loading="lazy">
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
  <script>
    (function(){
      var s = document.querySelector('[data-bd]'); if (!s) return;
      s.classList.add('bd-js');
      if (!('IntersectionObserver' in window)) { s.classList.add('on'); return; }
      new IntersectionObserver(function(v, io){ if (v[0].isIntersecting) { s.classList.add('on'); io.disconnect(); } }, { threshold: .25 }).observe(s);
    })();
  </script>
</section>

<section class="block wrap after-dark">
  <div class="head"><div><h2>{{ 'home.cat_h' | t }}</h2></div><a class="more" href="/collections/tutte-le-bici">{{ 'home.cat_all' | t }}</a></div>
  <div class="cats">
    {%- assign bento = 'usato-1,bici-da-strada,ebikes,gravel,mountain-bike,urban' | split: ',' -%}
    {%- for handle in bento -%}
      {%- assign c = collections[handle] -%}
      {%- if c != blank -%}
        <a class="cat {% if forloop.first %}hero2{% elsif forloop.index == 2 or forloop.index == 3 %}wide{% endif %}" href="{{ c.url }}">
          {%- if c.featured_image -%}<img class="bg" src="{{ c.featured_image | image_url: width: 900 }}" alt="" loading="lazy">{%- endif -%}
          <div class="vg"></div>
          {%- if forloop.first -%}<span class="flag"><i></i>{{ 'home.flag_unici' | t }}</span>{%- endif -%}
          <div class="lb">
            <span class="c">{{ 'home.modelli' | t: n: c.products_count }}</span>
            <h3>{{ c.title }}</h3>
            {%- if forloop.first -%}<p>{{ 'home.usato_p' | t }}</p>{%- endif -%}
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<section class="block wrap fullw">
  <div class="head"><div><p class="k">{{ 'home.arrivi_k' | t }}</p><h2>{{ 'home.arrivi_h' | t }}</h2></div><a class="more" href="/collections/new-arrivals">{{ 'home.vedi_tutte' | t }}</a></div>
  <div class="prods">
    {%- assign mostrate = 0 -%}
    {%- for p in collections['new-arrivals'].products limit: 24 -%}
      {%- if mostrate < 8 and p.featured_image and p.type != 'USATO' -%}
        {% render 'dz-card', product: p %}
        {%- assign mostrate = mostrate | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

