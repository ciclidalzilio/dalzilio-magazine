{%- comment -%}
  Collezione DZ 2026 — colonna filtri (nativi Shopify: si configurano
  nell'app gratuita "Search & Discovery"), griglia con le card nuove,
  ordinamento e paginazione.
{%- endcomment -%}
<div class="wrap">
  <nav class="crumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><b>{{ collection.title }}</b></nav>
  <div class="ltop">
    <div><h1>{{ collection.title }}</h1><div class="sub">{{ collection.products_count }} prodotti</div></div>
    <select class="sortsel" onchange="location.href=this.value">
      {%- assign base = collection.url | append: '?sort_by=' -%}
      <option value="{{ base }}manual" {% if collection.sort_by == 'manual' or collection.sort_by == blank %}selected{% endif %}>Ordina: Rilevanza</option>
      <option value="{{ base }}created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>Più recenti</option>
      <option value="{{ base }}price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>Prezzo crescente</option>
      <option value="{{ base }}price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>Prezzo decrescente</option>
      <option value="{{ base }}title-ascending" {% if collection.sort_by == 'title-ascending' %}selected{% endif %}>Nome A-Z</option>
    </select>
  </div>

  {%- comment -%} e-bike: due filtri rapidi a pillola invece delle card grandi {%- endcomment -%}
  {%- if collection.handle == 'ebikes' or collection.handle == 'e-mtb' or collection.handle == 'e-road-e-gravel' -%}
    <div class="fpills">
      <a class="fpill{% if collection.handle == 'ebikes' %} on{% endif %}" href="{{ collections['ebikes'].url }}">Tutte</a>
      <a class="fpill{% if collection.handle == 'e-mtb' %} on{% endif %}" href="{{ collections['e-mtb'].url }}">E-MTB</a>
      <a class="fpill{% if collection.handle == 'e-road-e-gravel' %} on{% endif %}" href="{{ collections['e-road-e-gravel'].url }}">E-Road / E-Gravel</a>
    </div>
  {%- endif -%}

  {%- comment -%} filtri attivi, rimovibili con un tocco {%- endcomment -%}
  {%- assign attivi = 0 -%}
  {%- for filter in collection.filters -%}
    {%- assign attivi = attivi | plus: filter.active_values.size -%}
    {%- if filter.type == 'price_range' and filter.min_value.value != blank -%}{%- assign attivi = attivi | plus: 1 -%}{%- endif -%}
  {%- endfor -%}
  {%- if attivi > 0 -%}
    <div class="fattivi">
      {%- for filter in collection.filters -%}
        {%- for v in filter.active_values -%}<a href="{{ v.url_to_remove }}">{{ v.label }}</a>{%- endfor -%}
        {%- if filter.type == 'price_range' and filter.min_value.value != blank or filter.max_value.value != blank -%}
          <a href="{{ filter.url_to_remove }}">Prezzo</a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="listwrap{% if collection.filters == blank or collection.filters.size == 0 %} nofiltri{% endif %}">
    {%- if collection.filters.size > 0 -%}
      <form class="filters" method="get">
        {%- if collection.sort_by != blank -%}<input type="hidden" name="sort_by" value="{{ collection.sort_by }}">{%- endif -%}
        <h4>Filtri</h4>
        {%- liquid
          comment
            Nell'usato conta la categoria (corsa, mtb...), non il brand.
          endcomment
          assign su_usato = false
          if collection.handle == 'usato-1' or collection.handle == 'usato'
            assign su_usato = true
          endif
        -%}
        {%- for filter in collection.filters -%}
          {%- liquid
            assign f_label = filter.label | downcase
            comment
              Il filtro metacampo "Compatible bike type" e' rumore: mai mostrato.
            endcomment
            if f_label contains 'compatible'
              continue
            endif
            comment
              Aperti di default: Prezzo e gruppi con filtri attivi; poi Categoria
              nell'usato, Brand altrove.
            endcomment
            assign f_open = false
            if filter.active_values.size > 0
              assign f_open = true
            elsif filter.type == 'price_range'
              assign f_open = true
            elsif su_usato
              if f_label contains 'categoria' or f_label contains 'tipo'
                assign f_open = true
              endif
            elsif f_label contains 'brand' or f_label contains 'marca'
              assign f_open = true
            endif
          -%}
          <details {% if f_open %}open{% endif %}>
            <summary>{{ filter.label }}</summary>
            {%- case filter.type -%}
              {%- when 'price_range' -%}
                <div class="fprice">
                  <input type="number" name="{{ filter.min_value.param_name }}" placeholder="Da €"
                         {% if filter.min_value.value %}value="{{ filter.min_value.value | money_without_currency | replace: ',', '.' }}"{% endif %} min="0">
                  <input type="number" name="{{ filter.max_value.param_name }}" placeholder="A €"
                         {% if filter.max_value.value %}value="{{ filter.max_value.value | money_without_currency | replace: ',', '.' }}"{% endif %} min="0">
                </div>
              {%- else -%}
                {%- for v in filter.values limit: 14 -%}
                  <label class="fopt">
                    <input type="checkbox" name="{{ v.param_name }}" value="{{ v.value }}"
                           {% if v.active %}checked{% endif %} {% if v.count == 0 and v.active == false %}disabled{% endif %}>
                    {{ v.label }}<span class="n">{{ v.count }}</span>
                  </label>
                {%- endfor -%}
            {%- endcase -%}
          </details>
        {%- endfor -%}
        <button class="btn sm block" type="submit" style="margin-top:14px">Applica filtri</button>
        {%- if attivi > 0 -%}<a class="btn ghost sm block" style="margin-top:8px" href="{{ collection.url }}">Azzera</a>{%- endif -%}
      </form>
    {%- endif -%}

    <div>
      {%- paginate collection.products by 24 -%}
        <div class="listgrid">
          {%- for p in collection.products -%}
            {% render 'dz-card', product: p %}
          {%- else -%}
            <p style="grid-column:1/-1;color:var(--muted);padding:40px 0">Nessun prodotto con questi filtri. <a href="{{ collection.url }}" style="text-decoration:underline">Azzera i filtri</a></p>
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <nav class="pagin" aria-label="Pagine">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">←</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}<span class="cur">{{ part.title }}</span>
              {%- else -%}<span>{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}">→</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</div>
<div style="height:40px"></div>
