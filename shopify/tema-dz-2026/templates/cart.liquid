{%- comment -%} Carrello DZ 2026 — semplice e funzionante, checkout standard Shopify. {%- endcomment -%}
<div class="wrap" style="max-width:860px">
  <nav class="crumb"><a href="{{ routes.root_url }}">{{ 'nav.home' | t }}</a><span>/</span><b>{{ 'nav.carrello' | t }}</b></nav>
  <div class="ltop"><div><h1>{{ 'cart.h1' | t }}</h1><div class="sub">{% if cart.item_count == 1 %}{{ 'cart.uno' | t }}{% else %}{{ 'cart.tanti' | t: n: cart.item_count }}{% endif %}</div></div></div>

  {%- if cart.item_count == 0 -%}
    <div style="background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:50px 24px;text-align:center">
      <h3 style="margin:0 0 8px">{{ 'cart.vuoto_t' | t }}</h3>
      <p style="color:var(--muted);margin:0 0 20px">{{ 'cart.vuoto_p' | t }}</p>
      <a class="btn" href="/collections/new-arrivals">{{ 'cart.arrivi' | t }}</a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <div style="display:flex;flex-direction:column;gap:14px">
        {%- for item in cart.items -%}
          <div style="display:flex;gap:14px;align-items:center;background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:14px">
            <a href="{{ item.url }}" style="flex-shrink:0;width:88px;height:70px;border-radius:10px;overflow:hidden;background:#fff;position:relative">
              {%- if item.image -%}<img src="{{ item.image | image_url: width: 200 }}" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:contain">{%- endif -%}
            </a>
            <div style="flex:1;min-width:0">
              <b style="font-size:14.5px;display:block;line-height:1.3"><a href="{{ item.url }}">{{ item.product.title }}</a></b>
              {%- unless item.variant.title == 'Default Title' -%}<span style="font-size:12px;color:var(--muted)">{{ item.variant.title }}</span>{%- endunless -%}
              <div style="display:flex;align-items:center;gap:10px;margin-top:8px">
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ 'cart.quantita' | t }}"
                       style="width:64px;padding:8px 10px;border-radius:10px;border:1px solid var(--line-strong);font-family:inherit">
                <a href="{{ item.url_to_remove }}" style="font-size:12.5px;color:var(--muted);text-decoration:underline">{{ 'cart.rimuovi' | t }}</a>
              </div>
            </div>
            <b style="font-size:1.05rem;white-space:nowrap">{{ item.final_line_price | money }}</b>
          </div>
        {%- endfor -%}
      </div>

      <div style="display:flex;align-items:center;justify-content:space-between;gap:14px;margin-top:22px;flex-wrap:wrap">
        <button type="submit" name="update" class="btn ghost sm">{{ 'cart.aggiorna' | t }}</button>
        <div style="text-align:right">
          <div style="font-size:1.5rem;font-weight:780;letter-spacing:-.03em">{{ cart.total_price | money }}</div>
          <span style="font-size:12px;color:var(--muted)">{{ 'cart.tot_note' | t }}</span>
        </div>
      </div>
      {% render 'dz-avviso-ferie' %}
      <button type="submit" name="checkout" class="btn block" style="margin-top:16px">{{ 'cart.checkout' | t }}</button>
    </form>
  {%- endif -%}
</div>
<div style="height:40px"></div>
