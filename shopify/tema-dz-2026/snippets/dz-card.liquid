{%- comment -%}
  Card prodotto — usata in home, collezioni, correlati e ricerca.
  Uso: {% render 'dz-card', product: prodotto %}
  Niente recensioni inventate; sull'usato mostra la data di pubblicazione.
{%- endcomment -%}
{%- assign in_sconto = false -%}
{%- if product.compare_at_price > product.price -%}{%- assign in_sconto = true -%}{%- endif -%}
<article class="prod">
  <a class="pimg" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {%- if product.featured_image -%}
      <img src="{{ product.featured_image | image_url: width: 640 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="640" height="480">
    {%- endif -%}
    {%- if product.type == 'USATO' -%}
      <span class="chip">Usato</span>
    {%- elsif product.type != blank and product.type != 'bike' -%}
      <span class="chip">{{ product.type | truncate: 14, '' }}</span>
    {%- endif -%}
    {%- if in_sconto -%}
      {%- assign perc = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
      <span class="chip sale">−{{ perc }}%</span>
    {%- endif -%}
  </a>
  <div class="pbody">
    <span class="brand">{{ product.vendor | replace: 'scott_sports', 'SCOTT' }}</span>
    <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {%- if product.type == 'USATO' and product.published_at -%}
      <span class="pdate">Pubblicato il {{ product.published_at | date: '%-d %B %Y' }}</span>
    {%- endif -%}
    <div class="foot">
      <span class="price{% if in_sconto %} sale{% endif %}">{{ product.price | money }}</span>
      {%- if in_sconto -%}<span class="old">{{ product.compare_at_price | money }}</span>{%- endif -%}
    </div>
  </div>
</article>
