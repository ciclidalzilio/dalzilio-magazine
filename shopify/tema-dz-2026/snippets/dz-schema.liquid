{%- comment -%}
  dz-schema.liquid — dati strutturati JSON-LD e tag Open Graph.
  Va renderizzato nell'<head> dal layout. Copre i requisiti Google per:
  - Product snippet + Merchant Listings (offerte con prezzo, disponibilità,
    condizione, GTIN/SKU, spedizione e politica di reso)
  - BreadcrumbList (prodotto e collezione)
  - ItemList con itemListElement sulle pagine collezione
  Più: BikeStore (dati negozio) e WebSite su tutte le pagine.
  Le bici spediscono gratis in Italia; su accessori niente shippingDetails
  per non dichiarare tariffe sbagliate.
{%- endcomment -%}

{%- liquid
  assign anno_prossimo = 'now' | date: '%Y' | plus: 1
  assign prezzo_valido = anno_prossimo | append: '-12-31'
-%}

{%- comment -%} ------- Open Graph / Twitter ------- {%- endcomment -%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title | escape }}">
{%- if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}
{%- if template contains 'product' and product -%}
<meta property="og:type" content="product">
{%- if product.featured_image %}<meta property="og:image" content="{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' }}">{% endif %}
<meta property="og:price:amount" content="{{ product.selected_or_first_available_variant.price | divided_by: 100.0 }}">
<meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- elsif template contains 'collection' and collection.image -%}
<meta property="og:type" content="website">
<meta property="og:image" content="{{ collection.image | image_url: width: 1200 | prepend: 'https:' }}">
{%- else -%}
<meta property="og:type" content="website">
<meta property="og:image" content="{{ 'logodz-colori.png' | file_url | prepend: 'https:' }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">

{%- comment -%} ------- Negozio + sito (tutte le pagine) ------- {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BikeStore",
  "@id": {{ shop.url | append: '/#negozio' | json }},
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  "logo": {{ 'logodz-colori.png' | file_url | prepend: 'https:' | json }},
  "image": {{ 'logodz-colori.png' | file_url | prepend: 'https:' | json }},
  "telephone": "+39 345 7815102",
  "email": "info@ciclidalzilio.com",
  "priceRange": "€€",
  "currenciesAccepted": "EUR",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Via Piave 34",
    "addressLocality": "Montebelluna",
    "addressRegion": "TV",
    "postalCode": "31044",
    "addressCountry": "IT"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 45.7776,
    "longitude": 12.0543
  },
  "hasMap": "https://www.google.com/maps?q=Cicli+Dal+Zilio,+Via+Piave+34,+Montebelluna+TV",
  "openingHoursSpecification": [
    { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday", "Tuesday", "Thursday", "Friday"], "opens": "09:30", "closes": "12:30" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday", "Tuesday", "Thursday", "Friday"], "opens": "15:30", "closes": "19:30" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Wednesday", "Saturday"], "opens": "09:30", "closes": "12:30" }
  ],
  "sameAs": ["https://www.instagram.com/ciclidalzilio/"]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": "{{ shop.url }}/search?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
}
</script>

{%- comment -%} ------- Pagina prodotto: Breadcrumb + Product ------- {%- endcomment -%}
{%- if template contains 'product' and product -%}
{%- capture e_bici %}{% render 'dz-e-bici', product: product %}{% endcapture -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} }
    {%- if collection -%}
    ,{ "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} }
    ,{ "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
    {%- else -%}
    ,{ "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
    {%- endif -%}
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ shop.url | append: product.url | json }},
  "description": {{ product.description | strip_html | strip_newlines | truncate: 500 | json }},
  {%- if product.images.size > 0 %}
  "image": [
    {%- for img in product.images limit: 8 -%}
    {{ img | image_url: width: 1600 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  {%- endif %}
  {%- if product.vendor != blank %}
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  {%- endif %}
  {%- if product.type != blank %}
  "category": {{ product.type | json }},
  {%- endif %}
  "sku": {{ product.selected_or_first_available_variant.sku | default: product.id | json }},
  {%- if product.type == 'USATO' -%}
  {%- assign condizione = 'https://schema.org/UsedCondition' -%}
  {%- else -%}
  {%- assign condizione = 'https://schema.org/NewCondition' -%}
  {%- endif -%}
  "offers": [
    {%- for variante in product.variants limit: 50 -%}
    {
      "@type": "Offer",
      "url": {{ shop.url | append: variante.url | json }},
      "price": {{ variante.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "priceValidUntil": {{ prezzo_valido | json }},
      "availability": {% if variante.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
      "itemCondition": {{ condizione | json }},
      {%- if variante.sku != blank %}
      "sku": {{ variante.sku | json }},
      {%- endif %}
      {%- assign gtin_len = variante.barcode | strip | size -%}
      {%- if variante.barcode != blank and gtin_len >= 8 and gtin_len <= 14 %}
      "gtin": {{ variante.barcode | strip | json }},
      {%- endif %}
      {%- if e_bici contains 'si' %}
      "shippingDetails": {
        "@type": "OfferShippingDetails",
        "shippingRate": { "@type": "MonetaryAmount", "value": 0, "currency": "EUR" },
        "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "IT" }
      },
      {%- endif %}
      "hasMerchantReturnPolicy": {
        "@type": "MerchantReturnPolicy",
        "applicableCountry": "IT",
        "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
        "merchantReturnDays": 14,
        "returnMethod": "https://schema.org/ReturnByMail"
      },
      "seller": { "@type": "Organization", "name": {{ shop.name | json }} }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{%- comment -%} ------- Pagina collezione: Breadcrumb + ItemList ------- {%- endcomment -%}
{%- if template contains 'collection' and collection -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} },
    { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} }
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": {{ collection.title | json }},
  "numberOfItems": {{ collection.products | size }},
  "itemListElement": [
    {%- for prodotto in collection.products limit: 50 -%}
    {
      "@type": "ListItem",
      "position": {{ forloop.index }},
      "name": {{ prodotto.title | json }},
      "url": {{ shop.url | append: prodotto.url | json }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
