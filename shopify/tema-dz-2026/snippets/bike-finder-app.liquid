  ];

  function findModel(title) {
    var n = norm(title);
    for (var i = 0; i < MODEL_DB.length; i++) {
      if (n.indexOf(MODEL_DB[i].pattern) !== -1) return MODEL_DB[i];
    }
    return null;
  }

  // Adeguatezza del profilo al livello scelto: 2 = ideale, 1 = accettabile, 0 = escludere
  function profileFit(p) {
    var t = state.terreno, lvl = state.livello;
    var entry = findModel(p.title);
    var prof = entry ? entry.profile : 'OTHER';

    if (t === 'strada' && state.motore === 'no') {
      // Scelta esplicita della gamma: domina su tutto
      if (state.gamma === 'race') return prof === 'RACE' ? 2 : (prof === 'OTHER' ? 1 : 0); // endurance escluse
      if (state.gamma === 'endurance') return prof === 'ENDURANCE' ? 2 : (prof === 'OTHER' ? 1 : 0); // race escluse
      // 'auto' o nessuna scelta: si decide in base al livello
      if (lvl === 'esperto') return prof === 'RACE' ? 2 : (prof === 'OTHER' ? 1 : 0);
      if (lvl === 'principiante') return prof === 'ENDURANCE' ? 2 : 1;
      return prof === 'OTHER' ? 1 : 2;
    }
    if (t === 'mtb') {
      // Scelta esplicita front/full: le bici con sospensione opposta sono escluse.
      if (state.sosp === 'front' || state.sosp === 'full') {
        var susp = entry && entry.susp ? entry.susp : null;
        if (susp && susp !== state.sosp) return 0;
        if (!susp) return 1; // modello non classificato: accettabile ma non ideale
      }
      // Scelta esplicita del tipo di motore (solo e-MTB)
      if (state.motore === 'si' && (state.emotor === 'full' || state.emotor === 'light')) {
        var em = entry && entry.emotor ? entry.emotor : null;
        if (em && em !== state.emotor) return 0;
        if (!em) return 1;
      }
      if (state.motore === 'no') {
        if (lvl === 'esperto') return (prof === 'XC_RACE' || prof === 'TRAIL' || prof === 'ENDURO') ? 2 : 1; // entry non ideali per esperti
        if (lvl === 'principiante') return prof === 'ENDURO' ? 1 : 2; // enduro impegnative per chi inizia
      }
      return 2;
    }
    if (t === 'gravel' && state.motore === 'no') {
      if (lvl === 'esperto') return (prof === 'RACE_GRAVEL' || prof === 'ALL_ROAD_FAST') ? 2 : 1;
      if (lvl === 'principiante') return prof === 'RACE_GRAVEL' ? 1 : 2;
      return 2;
    }
    return 2; // e-bike e citta: nessun filtro di profilo
  }

  // Disciplina richiesta per ogni terreno: una e-MTB non deve mai finire nei risultati gravel
  var TERRAIN_DISC = { strada: ['road'], gravel: ['gravel'], mtb: ['mtb'], citta: null };
  function discOk(p) {
    var allowed = TERRAIN_DISC[state.terreno];
    if (!allowed) return true; // citta': nessun vincolo di disciplina
    var e = findModel(p.title);
    if (!e || !e.disc) return true; // modello non classificato: lo lasciamo passare
    return allowed.indexOf(e.disc) !== -1;
  }

  function dedupe(list) {
    var seen = {}, out = [];
    list.forEach(function (p) {
      var key = (p.vendor + '|' + p.title).toLowerCase().replace(/[^a-z0-9]/g, '');
      if (seen[key]) {
        // preferisci il record disponibile
        if (p.available && !seen[key].available) {
          out[out.indexOf(seen[key])] = p; seen[key] = p;
        }
        return;
      }
      seen[key] = p; out.push(p);
    });
    return out;
  }

  function score(p, budget, livello, newestTs, oldestTs) {
    var s = 0;

    // Prezzo vicino al budget: più la bici sfrutta il budget, meglio è.
    if (p.price <= budget) {
      var usage = p.price / budget; // 0..1
      s += 100 * usage;
      // Il livello modula leggermente: chi inizia tollera meglio la fascia
      // media, ma la vicinanza al budget resta il criterio dominante.
      if (livello === 'principiante') s += 10 * (1 - Math.abs(usage - 0.8));
      else if (livello === 'intermedio') s += 10 * (1 - Math.abs(usage - 0.9));
      else s += 10 * usage;
    } else {
      // Sopra budget: forte penalità proporzionale allo sforamento
      var over = (p.price - budget) / budget;
      s -= 100 + over * 150;
    }

    // Recenza: bonus fino a 25 punti per le bici pubblicate più di recente
    if (newestTs > oldestTs && p.published) {
      var recency = (p.published - oldestTs) / (newestTs - oldestTs); // 0..1
      s += 25 * recency;
    }

    // Piccolo bonus se in offerta (compare_at > price)
    if (p.compare_at && p.compare_at > p.price) s += 8;

    // Preferenza per i marchi principali del negozio
    var vend = (p.vendor || '').toLowerCase();
    if (vend.indexOf('trek') !== -1 || vend.indexOf('scott') !== -1) s += 15;

    return s;
  }

  function computeResults() {
    var pools = pickPools();
    var budgetCents = state.budget * 100;

    function isCompleteBike(p) {
      var n = norm(p.title);
      // Esclude telai e frameset: non sono bici complete da proporre
      return n.indexOf('telaio') === -1 && n.indexOf('frameset') === -1;
    }

    // L'usato mescola bici con e senza motore: rispetta la scelta del cliente
    function motorOkUsato(p) {
      var isEbike = /eride|e-?bike|\bneo\b|domane\+|\bexe\b|avinox|amflow/i.test(p.title || '');
      return state.motore === 'si' ? isEbike : !isEbike;
    }

    function gather(handles) {
      var list = [];
      handles.forEach(function (h) {
        (COLLS[h] || []).forEach(function (p) {
          if (h === 'usato' && !motorOkUsato(p)) return;
          list.push(p);
        });
      });
      return dedupe(list.filter(isCompleteBike).filter(matchesTerrainHint).filter(discOk));
    }

    var candidates = gather(pools.primary);
    if (candidates.length < 3 && pools.secondary.length) {
      candidates = dedupe(candidates.concat(gather(pools.secondary)));
    }

    // Escludi i profili non adatti al livello (es. endurance per agonisti).
    // Se il filtro rigido lascia meno di 3 bici, riammetti le "accettabili" (fit 1).
    var idealOnly = candidates.filter(function (p) { return profileFit(p) === 2; });
    var acceptable = candidates.filter(function (p) { return profileFit(p) >= 1; });
    candidates = idealOnly.length >= 3 ? idealOnly : acceptable;

    // Taglia giusta e disponibile: e' il criterio piu' importante.
    // Le bici con taglie note ma NON adatte (fit 0) sono sempre escluse;
    // quelle senza taglia indicata (fit 1) rientrano solo se mancano proposte.
    var rightSize = candidates.filter(function (p) { return sizeFit(p) === 2; });
    var sizeUnknownOk = candidates.filter(function (p) { return sizeFit(p) >= 1; });
    var sizeGuaranteed = rightSize.length >= 3;
    candidates = sizeGuaranteed ? rightSize : sizeUnknownOk;

    // Solo bici disponibili. Le esaurite rientrano unicamente se non
    // riusciamo a proporne almeno 3 disponibili.
    var availableOnly = candidates.filter(function (p) { return p.available; });
    var usedUnavailableFill = false;
    var pool = availableOnly;
    if (availableOnly.length < 3) {
      usedUnavailableFill = candidates.length > availableOnly.length;
      pool = candidates;
    }

    var withinBudget = pool.filter(function (p) { return p.price <= budgetCents; });
    var isFallback = withinBudget.length === 0 && pool.length > 0;

    // Range temporale per normalizzare il bonus recenza
    var timestamps = pool.map(function (p) { return p.published || 0; });
    var newestTs = Math.max.apply(null, timestamps.concat(0));
    var oldestTs = Math.min.apply(null, timestamps.length ? timestamps : [0]);

    var ranked = pool
      .map(function (p) { return { p: p, s: score(p, budgetCents, state.livello, newestTs, oldestTs) }; })
      .sort(function (a, b) {
        // Le disponibili vengono SEMPRE prima delle esaurite,
        // a prescindere dal punteggio.
        if (a.p.available !== b.p.available) return a.p.available ? -1 : 1;
        // La taglia giusta e disponibile viene prima di quella non indicata
        var sza = sizeFit(a.p), szb = sizeFit(b.p);
        if (sza !== szb) return szb - sza;
        // Il profilo ideale per il livello viene prima di quello accettabile
        var fa = profileFit(a.p), fb = profileFit(b.p);
        if (fa !== fb) return fb - fa;
        if (b.s !== a.s) return b.s - a.s;
        // A parità di punteggio, vince la più recente
        return (b.p.published || 0) - (a.p.published || 0);
      })
      .map(function (r) { return r.p; });

    // Tendenzialmente 3 marchi diversi: prendo la migliore di ogni brand
    // in ordine di classifica; se i brand non bastano, riempio con le successive.
    var picked = [], seenVendors = {};
    ranked.forEach(function (p) {
      var v = (p.vendor || '').toLowerCase();
      if (picked.length < 3 && !seenVendors[v]) { picked.push(p); seenVendors[v] = 1; }
    });
    if (picked.length < 3) {
      ranked.forEach(function (p) {
        if (picked.length < 3 && picked.indexOf(p) === -1) picked.push(p);
      });
    }

    return { top: picked, isFallback: isFallback, budgetCents: budgetCents, newestTs: newestTs, oldestTs: oldestTs, sizeGuaranteed: sizeGuaranteed };
  }

  // ---- Render ----
  function setProgress(fraction) {
    if (progressBar) progressBar.style.width = Math.round(fraction * 100) + '%';
  }

  function renderQuestion() {
    var qs = getQuestions();
    var q = qs[step];
    setProgress(step / (qs.length + 1));
    var html = '<h3 class="bf__q-title">' + q.title + '</h3>' +
      '<p class="bf__q-sub">' + q.sub + '</p>' +
      '<div class="bf__opts">' +
      q.options.map(function (o) {
        return '<button type="button" class="bf__opt" data-value="' + o.value + '">' +
          '<span>' + o.label + '</span><span class="bf__opt-arrow">→</span></button>';
      }).join('') +
      '</div>' +
      (step > 0 ? '<div class="bf__nav"><button type="button" class="bf__back" data-bf-back>← indietro</button></div>' : '');
    app.innerHTML = html;

    app.querySelectorAll('.bf__opt').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var v = btn.getAttribute('data-value');
        if (q.key === 'terreno' && v !== state.terreno) { state.gamma = null; state.sosp = null; state.emotor = null; }
        if (q.key === 'motore' && v !== 'si') state.emotor = null;
        if (q.key === 'gamma' && v !== state.gamma) {
          // Race implica muscolare; cambiando gamma la scelta motore torna da fare
          state.motore = v === 'race' ? 'no' : null;
        }
        state[q.key] = q.key === 'budget' ? parseInt(v, 10) : v;
        step++;
        step < getQuestions().length ? renderQuestion() : renderResults();
      });
    });
    var back = app.querySelector('[data-bf-back]');
    if (back) back.addEventListener('click', function () { step = Math.max(0, step - 1); renderQuestion(); });
  }

  // Genera 2-3 motivazioni concrete per ogni bici proposta
  function buildReasons(p, budgetCents, newestTs, oldestTs) {
    var reasons = [];
    var t = state.terreno, m = state.motore;

    // 0. Taglia giusta e disponibile: il motivo piu' importante
    if (state.altezza && sizeFit(p) === 2) {
      reasons.push('Disponibile nella taglia adatta alla tua altezza');
    }

    // 1. Aderenza al budget
    if (p.price <= budgetCents) {
      var usage = p.price / budgetCents;
      if (usage >= 0.85) reasons.push('Sfrutta al meglio il tuo budget');
      else if (usage >= 0.6) reasons.push('Ben dentro il tuo budget');
      else reasons.push('Ti lascia margine sul budget');
    } else {
      var overPct = Math.round(((p.price - budgetCents) / budgetCents) * 100);
      reasons.push('Supera il budget del ' + overPct + '%, ma è la più vicina');
    }

    // 2. Offerta in corso
    if (p.compare_at && p.compare_at > p.price) {
      var discPct = Math.round((1 - p.price / p.compare_at) * 100);
      if (discPct >= 5) reasons.push('In offerta: -' + discPct + '% sul listino');
    }

    // 3. Novità in negozio (nel terzo più recente del gruppo)
    if (newestTs > oldestTs && p.published) {
      var recency = (p.published - oldestTs) / (newestTs - oldestTs);
      if (recency >= 0.66) reasons.push('Tra gli ultimi arrivi in negozio');
    }

    // 4. Coerenza col terreno scelto
    if (reasons.length < 3) {
      var dbEntry = findModel(p.title);
      if ((state.sosp === 'front' || state.sosp === 'full') && dbEntry && dbEntry.susp === state.sosp) {
        reasons.push(state.sosp === 'front' ? 'Hardtail (front), come richiesto' : 'Full suspension, come richiesto');
      }
      if ((state.emotor === 'full' || state.emotor === 'light') && dbEntry && dbEntry.emotor === state.emotor) {
        reasons.push(state.emotor === 'full' ? 'Motore full power, come richiesto' : 'Motore light, come richiesto');
      }
      if (dbEntry) {
        reasons.push(dbEntry.label);
      }
      var terrainLabel =
        t === 'strada' ? (m === 'si' ? 'Pensata per la strada, con motore' : 'Geometria e peso da strada') :
        t === 'gravel' ? (m === 'si' ? 'E-gravel: sterrato con assistenza' : 'Versatile su sterrato e asfalto') :
        t === 'mtb'    ? (m === 'si' ? 'E-MTB: più salite, meno fatica' : 'Progettata per i sentieri') :
                         (m === 'si' ? 'Comoda e assistita per ogni giorno' : 'Pratica per l\'uso quotidiano');
      if (!dbEntry) reasons.push(terrainLabel);
    }

    // 5. Disponibilità immediata come chiusura
    if (reasons.length < 3 && p.available) {
      reasons.push('Disponibile subito');
    }

    return reasons.slice(0, 3);
  }

  function cardHTML(p, index, budgetCents, newestTs, oldestTs) {
    var isTop = index === 0;
    return '<article class="bf__card' + (isTop ? ' bf__card--top' : '') + '">' +
      (isTop ? '<span class="bf__badge">La nostra scelta</span>' : '') +
      '<div class="bf__img-wrap">' +
        (p.image
          ? '<img class="bf__img" src="' + p.image + '" loading="lazy" alt="' + p.title.replace(/"/g, '&quot;') + '">'
          : '') +
      '</div>' +
      '<div class="bf__card-body">' +
        '<p class="bf__vendor">' + (p.vendor || '') + '</p>' +
        '<h4 class="bf__model">' + p.title + '</h4>' +
        '<div class="bf__price-row">' +
          '<span class="bf__price">' + MONEY(p.price) + '</span>' +
          (p.compare_at && p.compare_at > p.price ? '<span class="bf__compare">' + MONEY(p.compare_at) + '</span>' : '') +
        '</div>' +
        '<p class="bf__avail' + (p.available ? '' : ' bf__avail--out') + '">' + (p.available ? 'Disponibile' : 'Su ordinazione / esaurito') + '</p>' +
        '<ul class="bf__reasons">' +
          buildReasons(p, budgetCents, newestTs, oldestTs).map(function (r) {
            return '<li class="bf__reason">' + r + '</li>';
          }).join('') +
        '</ul>' +
        '<a class="bf__cta" href="' + p.url + '">Vedi la bici</a>' +
        (WHATSAPP ? '<a class="bf__cta bf__cta--wa" target="_blank" rel="noopener" href="https://wa.me/' + WHATSAPP + '?text=' + encodeURIComponent('Ciao! Ho fatto il Bike Finder e vorrei informazioni su: ' + p.title + ' (' + MONEY(p.price) + ')') + '">\uD83D\uDCAC Info su WhatsApp</a>' : '') +
      '</div>' +
    '</article>';
  }

  // ---- Tabella di confronto tra le 3 proposte ----
  function profileName(prof) {
    return {
      RACE: 'Race', ENDURANCE: 'Endurance',
      RACE_GRAVEL: 'Gravel race', ALL_ROAD_FAST: 'Gravel veloce', ADVENTURE: 'Gravel avventura',
      XC_RACE: 'XC / Race', TRAIL: 'Trail', ENDURO: 'Enduro', XC_ENTRY: 'XC entry',
      EBIKE: 'E-bike'
    }[prof] || '\u2014';
  }

  function shortName(p) {
    var t = (p.title || '').replace(/^bicicletta\s+/i, '');
    return t.length > 26 ? t.slice(0, 24) + '\u2026' : t;
  }

  function cmpTableHTML(top, newestTs, oldestTs) {
    if (top.length < 2) return '';
    var rows = [];
    function row(label, cells) {
      rows.push('<tr><th>' + label + '</th>' + cells.map(function (c) { return '<td>' + c + '</td>'; }).join('') + '</tr>');
    }

    row('Prezzo', top.map(function (p) {
      return '<strong>' + MONEY(p.price) + '</strong>' +
        (p.compare_at && p.compare_at > p.price ? '<br><s>' + MONEY(p.compare_at) + '</s>' : '');
    }));

    row('Vs prima scelta', top.map(function (p, i) {
      if (i === 0) return '\u2014';
      var diff = p.price - top[0].price;
      if (diff === 0) return 'Stesso prezzo';
      return (diff < 0 ? '\u2212 ' : '+ ') + MONEY(Math.abs(diff)).replace('\u20ac ', '\u20ac');
    }));

    row('Tipo', top.map(function (p) {
      var e = findModel(p.title);
      return e ? profileName(e.profile) : '\u2014';
    }));

    if (state.terreno === 'mtb') {
      row('Sospensioni', top.map(function (p) {
        var e = findModel(p.title);
        if (!e || !e.susp) return '\u2014';
        return e.susp === 'front' ? 'Front (hardtail)' : 'Full suspension';
      }));
    }

    if (state.terreno === 'mtb' && state.motore === 'si') {
      row('Motore', top.map(function (p) {
        var e = findModel(p.title);
        if (!e || !e.emotor) return '\u2014';
        var nm = (e.label || '').match(/(\d+)\s*Nm/);
        return (e.emotor === 'full' ? 'Full power' : 'Light') + (nm ? '<br>' + nm[1] + ' Nm' : '');
      }));
      row('Batteria', top.map(function (p) {
        var e = findModel(p.title);
        var wh = e && e.label ? e.label.match(/(\d+(?:\/\d+)?(?:\+\d+)?)\s*Wh/) : null;
        return wh ? wh[1] + ' Wh' : '\u2014';
      }));
    }

    if (state.altezza) {
      row('Taglia per te', top.map(function (p) {
        return sizeFit(p) === 2 ? '\u2713 Disponibile' : 'Da verificare';
      }));
    }

    row('Novit\u00e0', top.map(function (p) {
      if (newestTs > oldestTs && p.published) {
        var rec = (p.published - oldestTs) / (newestTs - oldestTs);
        if (rec >= 0.66) return '\u2713 Nuovo arrivo';
      }
      return '\u2014';
    }));

    return '<div class="bf__cmp">' +
      '<h4 class="bf__cmp-title">Confronto rapido</h4>' +
      '<div class="bf__cmp-scroll"><table class="bf__cmp-table">' +
      '<thead><tr><th></th>' + top.map(function (p, i) {
        return '<th>' + (i === 0 ? '\u2605 ' : '') + shortName(p) + '</th>';
      }).join('') + '</tr></thead>' +
      '<tbody>' + rows.join('') + '</tbody></table></div></div>';
  }

  function renderResults() {
    setProgress(1);
    var r = computeResults();

    if (!r.top.length) {
      app.innerHTML = '<div class="bf__empty">' +
        '<h3 class="bf__q-title">Non abbiamo trovato bici per questi criteri</h3>' +
        '<p class="bf__q-sub">Prova a cambiare qualche risposta, oppure contattaci: troviamo la bici giusta insieme.</p>' +
        '<a class="bf__cta" style="display:inline-block;max-width:260px" href="/pages/contact">Contattaci</a>' +
        '<div class="bf__footer-actions"><button type="button" class="bf__restart" data-bf-restart>↺ Ricomincia</button></div>' +
      '</div>';
    } else {
      app.innerHTML =
        '<div class="bf__results-head">' +
          '<p class="bf__results-tag">Le tue 3 proposte</p>' +
          '<h3 class="bf__results-title">Ecco le bici più adatte a te</h3>' +
        '</div>' +
        (r.isFallback
          ? '<p class="bf__note">Nessun modello rientra esattamente nel budget indicato: queste sono le opzioni più vicine.</p>'
          : '') +
        (!r.sizeGuaranteed && state.altezza
          ? '<p class="bf__note">Alcune proposte non indicano la taglia: contattaci per verificare la misura giusta per te.</p>'
          : '') +
        '<div class="bf__grid">' + r.top.map(function (p, i) { return cardHTML(p, i, r.budgetCents, r.newestTs, r.oldestTs); }).join('') + '</div>' +
        '<p class="bf__swipe-hint">Scorri per vedere le altre proposte &rarr;</p>' +
        cmpTableHTML(r.top, r.newestTs, r.oldestTs) +
        '<div class="bf__footer-actions"><button type="button" class="bf__restart" data-bf-restart>↺ Rifai il test</button></div>';
    }

    var restart = app.querySelector('[data-bf-restart]');
    if (restart) restart.addEventListener('click', function () {
      state = { terreno: null, gamma: null, sosp: null, emotor: null, motore: null, budget: null, livello: null, altezza: null };
      step = 0;
      renderQuestion();
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  renderQuestion();

  // ---- Popup: apertura/chiusura ----
  var modal = document.getElementById('bf-modal');
  var openBtn = document.querySelector('[data-bf-open]');
  if (modal && openBtn) {
    function bfOpen() {
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      modal.querySelector('.bf-modal__panel').scrollTop = 0;
    }
    function bfClose() {
      modal.hidden = true;
      document.body.style.overflow = '';
    }
    openBtn.addEventListener('click', bfOpen);
    modal.querySelectorAll('[data-bf-close]').forEach(function (el) {
      el.addEventListener('click', bfClose);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !modal.hidden) bfClose();
    });
  }
})();
</script>