{% comment %}
  bike-finder-app — Bike Finder come SNIPPET, inseribile ovunque.

  USO: in una sezione "Liquid personalizzato" incolla:

    {% render 'bike-finder-app', whatsapp: '393401234567', cover: 'URL_IMMAGINE' %}

  Mostra una COPERTINA con la tua immagine e il bottone "Inizia il test";
  al click si apre il bike finder in un popup.
  Per l'immagine: Admin -> Contenuto -> File -> carica -> copia link.

  Parametri opzionali (tutti con default):
    whatsapp:  numero WhatsApp, solo cifre con prefisso. Vuoto = bottone nascosto
    cover:     URL dell'immagine di copertina. Vuoto = sfondo scuro elegante
    subtitle:  sottotitolo sulla copertina
    cta:       testo del bottone (default: "INIZIA IL TEST")
    heading:   titolo (default: "Trova la tua bici in pochi passi")
    eyebrow:   occhiello sopra il titolo (default: "Cicli Dal Zilio")
    bg:        colore sfondo (default: #fafaf8)
    accent:    colore accento (default: #c8102e)

  Esempio completo:
    {% render 'bike-finder-app', whatsapp: '393401234567', heading: 'Qual è la tua bici?', accent: '#c8102e' %}

  Richiede lo snippet bf-product-json gia' presente nel tema.
{% endcomment %}
{%- liquid
  assign bf_whatsapp = whatsapp | default: ''
  assign bf_heading = heading | default: 'Trova la tua bici in pochi passi'
  assign bf_eyebrow = eyebrow | default: ''
  assign bf_bg = bg | default: '#fafaf8'
  assign bf_accent = accent | default: '#c8102e'
  assign bf_cover = cover | default: ''
  assign bf_subtitle = subtitle | default: 'Poche domande. Le 3 bici giuste per te, nella tua taglia.'
  assign bf_cta = cta | default: 'INIZIA IL TEST'
-%}

{%- comment -%} ============ COPERTINA (visibile in pagina) ============ {%- endcomment -%}
<section class="bfc" id="bfc-cover">
  {%- comment -%} La foto di default e' incorporata; passa cover: 'URL' per sostituirla {%- endcomment -%}
  <div class="bfc__card bfc__card--img"
       style="--bfc-img: url('{% if bf_cover != blank %}{{ bf_cover }}{% else %}data:image/jpeg;base64,{% endif %}'); --bfc-img-m: url('{% if bf_cover != blank %}{{ bf_cover }}{% else %}data:image/jpeg;base64,{% endif %}');">
    <div class="bfc__content">
      {% if bf_eyebrow != blank %}<p class="bfc__eyebrow">{{ bf_eyebrow }}</p>{% endif %}
      <h2 class="bfc__title">{{ bf_heading }}</h2>
      <p class="bfc__sub">{{ bf_subtitle }}</p>
      <button type="button" class="bfc__btn" data-bf-open>{{ bf_cta }} <span class="bfc__arrow">&rarr;</span></button>
      <p class="bfc__trust">Dati reali del catalogo &nbsp;&bull;&nbsp; Solo bici disponibili &nbsp;&bull;&nbsp; Nella tua taglia</p>
    </div>
  </div>
</section>

{%- comment -%} ============ POPUP col percorso vero ============ {%- endcomment -%}
<div class="bf-modal" id="bf-modal" hidden>
  <div class="bf-modal__backdrop" data-bf-close></div>
  <div class="bf-modal__panel" role="dialog" aria-modal="true" aria-label="{{ bf_heading }}">
    <button type="button" class="bf-modal__close" data-bf-close aria-label="Chiudi">&times;</button>
{%- liquid
  assign c_strada = collections['bici-da-strada']
  assign c_mtb = collections['mountain-bike']
  assign c_gravel = collections['gravel']
  assign c_emtb = collections['ebikes']
  assign c_eroad = collections['e-road-e-gravel']
  assign c_urban = collections['urban']
  assign c_usato = collections['usato-1']
-%}

<section class="bf" id="bf-app">
  <div class="bf__inner">
    <header class="bf__head">
      <p class="bf__eyebrow">{{ bf_eyebrow }}</p>
      <h2 class="bf__title">{{ bf_heading }}</h2>
    </header>

    <div class="bf__progress" aria-hidden="true">
      <div class="bf__progress-bar" data-bf-progress></div>
    </div>

    <div data-bf-app>
      <noscript>
        <p>Per usare il bike finder attiva JavaScript, oppure <a href="{{ routes.collections_url }}">sfoglia le collezioni</a>.</p>
      </noscript>
    </div>
  </div>

  {%- comment -%} Dati prodotti: stampati da Liquid, letti dal JS {%- endcomment -%}
  <script type="application/json" data-bf-data>
  {
    "collections": {
      "strada": [{%- for product in c_strada.products limit: 100 -%}{%- render 'bf-product-json', product: product -%}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
      "mtb": [{%- for product in c_mtb.products limit: 100 -%}{%- render 'bf-product-json', product: product -%}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
      "gravel": [{%- for product in c_gravel.products limit: 100 -%}{%- render 'bf-product-json', product: product -%}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
      "emtb": [{%- for product in c_emtb.products limit: 100 -%}{%- render 'bf-product-json', product: product -%}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
      "eroad": [{%- for product in c_eroad.products limit: 100 -%}{%- render 'bf-product-json', product: product -%}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
      "urban": [{%- for product in c_urban.products limit: 100 -%}{%- render 'bf-product-json', product: product -%}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
      "usato": [{%- for product in c_usato.products limit: 100 -%}{%- render 'bf-product-json', product: product -%}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
    }
  }
  </script>
</section>
  </div>
</div>

{% style %}
  /* ---- Copertina: premium chiara (bianco, testo nero) ---- */
  .bfc { padding: 6px; }
  .bfc__card {
    position: relative; border-radius: 24px;
    background: linear-gradient(180deg, #ffffff 0%, #f4f5f6 100%);
    border: 1px solid #e9ebee;
    box-shadow: 0 12px 44px rgba(15, 18, 22, .07);
    min-height: 340px; display: flex; align-items: center;
    isolation: isolate;
  }
  .bfc__card::before {
    content: ''; position: absolute; inset: -6px; z-index: -1;
    border-radius: 28px;
    background: linear-gradient(120deg,
      rgba(120, 140, 255, .45) 0%,
      rgba(200, 120, 255, .30) 28%,
      rgba(255, 150, 180, .28) 52%,
      rgba(120, 200, 255, .38) 78%,
      rgba(120, 140, 255, .45) 100%);
    filter: blur(30px);
    opacity: .45;
  }

  /* con immagine: la foto occupa la meta' destra, il testo resta su bianco */
  .bfc__card--img {
    background-image:
      linear-gradient(to right, #ffffff 0%, #ffffff 40%, rgba(255,255,255,.55) 62%, rgba(255,255,255,.18) 100%),
      var(--bfc-img);
    background-size: auto, contain;
    background-position: right center, right 28px center;
    background-repeat: no-repeat;
  }
  .bfc__overlay { display: none; }
  .bfc__content { position: relative; padding: 48px 44px; max-width: 560px; }
  .bfc__eyebrow { color: #8a8f98; font-size: 12px; letter-spacing: .22em; text-transform: uppercase; margin: 0 0 12px; font-weight: 600; }
  .bfc__title { color: #101317; font-size: clamp(28px, 4vw, 46px); line-height: 1.06; margin: 0 0 12px; font-weight: 700; letter-spacing: -0.01em; }
  .bfc__sub { color: #6b6f76; font-size: 16px; line-height: 1.5; margin: 0 0 26px; }
  .bfc__btn {
    display: inline-flex; align-items: center; gap: 12px;
    background: #101317; color: #fff; border: none; cursor: pointer;
    font-size: 14px; font-weight: 700; letter-spacing: .06em;
    padding: 16px 30px; border-radius: 999px; transition: transform .1s, opacity .15s;
  }
  .bfc__btn:hover { opacity: .88; }
  .bfc__btn:active { transform: scale(.98); }
  .bfc__arrow { font-size: 17px; }
  .bfc__trust { margin: 18px 0 0; font-size: 12.5px; color: #9aa0a6; }
  @media (max-width: 749px) {
    .bfc__card { min-height: 0; border-radius: 16px; align-items: flex-end; }
    .bfc__card--img {
      background-image:
        linear-gradient(to bottom,
          rgba(255,255,255,0) 0%,
          rgba(255,255,255,0) 18%,
          rgba(255,255,255,.18) 32%,
          rgba(255,255,255,.45) 45%,
          rgba(255,255,255,.75) 58%,
          rgba(255,255,255,.94) 70%,
          #ffffff 80%),
        var(--bfc-img-m, var(--bfc-img));
      background-size: auto, 118% auto;
      background-position: center top, center top;
      background-repeat: no-repeat;
      padding-top: 215px;
    }
    .bfc__content { padding: 20px 20px 26px; }
    .bfc__sub { font-size: 14px; }
  }

  /* ---- Popup ---- */
  .bf-modal { position: fixed; inset: 0; z-index: 9999; }
  .bf-modal[hidden] { display: none; }
  .bf-modal__backdrop { position: absolute; inset: 0; background: rgba(10, 12, 14, .62); backdrop-filter: blur(2px); }
  .bf-modal__panel {
    position: absolute; inset: 0; margin: auto;
    width: min(960px, calc(100% - 24px)); height: min(92vh, 100%);
    background: {{ bf_bg }}; border-radius: 20px; overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    box-shadow: 0 24px 80px rgba(0,0,0,.35);
  }
  .bf-modal__close {
    position: sticky; top: 12px; margin-left: calc(100% - 56px);
    width: 42px; height: 42px; border-radius: 50%;
    border: none; background: #14171a; color: #fff; font-size: 24px; line-height: 1;
    cursor: pointer; z-index: 2;
  }
  .bf-modal__close:hover { opacity: .85; }
  @media (max-width: 749px) {
    .bf-modal__panel { width: 100%; height: 100%; border-radius: 0; }
  }
  .bf { background: {{ bf_bg }}; padding: 8px 20px 48px; }
  .bf__inner { max-width: 860px; margin: 0 auto; }
  .bf__head { text-align: center; margin-bottom: 24px; }
  .bf__eyebrow { font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: #8a8f98; margin: 0 0 8px; }
  .bf__title { font-size: clamp(26px, 4vw, 38px); margin: 0; line-height: 1.1; }
  .bf__progress { height: 4px; background: #e8e8e8; border-radius: 999px; overflow: hidden; margin: 0 auto 32px; max-width: 420px; }
  .bf__progress-bar { height: 100%; width: 0; background: {{ bf_accent }}; transition: width .35s ease; }

  .bf__q-title { font-size: 22px; text-align: center; margin: 0 0 6px; }
  .bf__q-sub { text-align: center; color: #6b6f76; font-size: 14px; margin: 0 0 24px; }
  .bf__opts { display: grid; gap: 10px; max-width: 480px; margin: 0 auto; }
  .bf__opt {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 16px 18px; border: 1.5px solid #dcdfe3; border-radius: 14px;
    background: #fff; font-size: 16px; cursor: pointer; text-align: left;
    transition: border-color .15s, transform .05s;
  }
  .bf__opt:hover { border-color: {{ bf_accent }}; }
  .bf__opt:active { transform: scale(.99); }
  .bf__opt-arrow { color: {{ bf_accent }}; }

  .bf__nav { display: flex; justify-content: center; margin-top: 22px; }
  .bf__back {
    background: none; border: none; color: #8a8f98; font-size: 13px;
    text-decoration: underline; text-underline-offset: 3px; cursor: pointer;
  }

  .bf__results-head { text-align: center; margin-bottom: 26px; }
  .bf__results-tag { font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: {{ bf_accent }}; margin: 0 0 6px; font-weight: 600; }
  .bf__results-title { font-size: clamp(22px, 3.4vw, 32px); margin: 0; }
  .bf__note { max-width: 560px; margin: 0 auto 22px; text-align: center; font-size: 14px; color: #6b6f76; background: #f5f5f3; border-radius: 12px; padding: 12px 16px; }

  .bf__grid { display: grid; gap: 18px; grid-template-columns: repeat(3, 1fr); }
  /* Tra 620 e 719px: 3 colonne compatte */
  @media (min-width: 620px) and (max-width: 719px) {
    .bf__grid { gap: 8px; }
    .bf__card { border-radius: 12px; }
    .bf__badge { font-size: 8px; padding: 4px 7px; top: 6px; left: 6px; letter-spacing: .05em; }
    .bf__card-body { padding: 9px; }
    .bf__vendor { font-size: 9px; margin-bottom: 2px; }
    .bf__model { font-size: 12px; margin-bottom: 6px; }
    .bf__price { font-size: 14px; }
    .bf__reason { font-size: 9.5px; padding-left: 13px; }
    .bf__cta { font-size: 11px; padding: 8px; margin-top: 9px; }
    .bf__cta--wa { margin-top: 6px; font-size: 10.5px; }
  }
  /* Telefono: carosello a scorrimento, card grandi e leggibili */
  @media (max-width: 619px) {
    .bf__grid {
      display: flex; gap: 12px;
      overflow-x: auto; -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      padding: 4px 4px 14px;
      margin: 0 -4px;
      scrollbar-width: none;
    }
    .bf__grid::-webkit-scrollbar { display: none; }
    .bf__card { min-width: 78%; scroll-snap-align: center; }
    .bf__swipe-hint {
      display: block; text-align: center;
      font-size: 12px; color: #9aa0a6; margin: 2px 0 0;
    }
  }
  .bf__swipe-hint { display: none; }

  .bf__card {
    border: 1px solid #e4e6e9; border-radius: 18px; overflow: hidden;
    background: #fff; display: flex; flex-direction: column; position: relative;
  }
  .bf__card--top { border-color: {{ bf_accent }}; border-width: 2px; }
  .bf__badge {
    position: absolute; top: 12px; left: 12px; z-index: 1;
    background: {{ bf_accent }}; color: #fff;
    font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    padding: 6px 10px; border-radius: 999px;
  }
  .bf__img-wrap { background: #f7f7f6; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; }
  .bf__img { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; }
  .bf__card-body { padding: 16px; display: flex; flex-direction: column; flex: 1; }
  .bf__vendor { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: #8a8f98; margin: 0 0 4px; }
  .bf__model { font-size: 16px; font-weight: 600; margin: 0 0 10px; line-height: 1.3; }
  .bf__price-row { display: flex; align-items: baseline; gap: 8px; margin-top: auto; }
  .bf__price { font-size: 19px; font-weight: 700; }
  .bf__compare { font-size: 13px; color: #9aa0a6; text-decoration: line-through; }
  .bf__avail { font-size: 12px; margin: 6px 0 0; color: #4a7c3f; }
  .bf__avail--out { color: #b0541f; }
  .bf__reasons { list-style: none; margin: 10px 0 0; padding: 0; display: grid; gap: 5px; }
  .bf__reason { font-size: 12.5px; color: #55595f; padding-left: 18px; position: relative; line-height: 1.35; }
  .bf__reason::before { content: "\2713"; position: absolute; left: 0; color: {{ bf_accent }}; font-weight: 700; }
  .bf__cta {
    display: block; text-align: center; margin-top: 14px; padding: 12px;
    background: #14171a; color: #fff; border-radius: 999px; text-decoration: none;
    font-size: 14px; font-weight: 600; transition: opacity .15s;
  }
  .bf__cta:hover { opacity: .85; }
  .bf__cta--wa { background: #25D366; color: #fff; margin-top: 8px; }
  .bf__cta--wa:hover { opacity: .9; }

  .bf__cmp { margin-top: 28px; }
  .bf__cmp-title { font-size: 17px; margin: 0 0 12px; text-align: center; }
  .bf__cmp-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid #e4e6e9; border-radius: 14px; background: #fff; }
  .bf__cmp-table { border-collapse: collapse; width: 100%; min-width: 560px; font-size: 13.5px; }
  .bf__cmp-table th, .bf__cmp-table td { padding: 10px 14px; text-align: left; border-bottom: 1px solid #eef0f2; vertical-align: top; }
  .bf__cmp-table thead th { font-size: 12.5px; background: #f7f7f6; }
  .bf__cmp-table thead th:first-child { width: 110px; }
  .bf__cmp-table tbody th { font-weight: 600; color: #6b6f76; font-size: 12.5px; white-space: nowrap; }
  .bf__cmp-table tbody tr:last-child th, .bf__cmp-table tbody tr:last-child td { border-bottom: none; }
  .bf__cmp-table s { color: #9aa0a6; font-weight: 400; }
  .bf__empty { text-align: center; padding: 40px 16px; }
  .bf__restart {
    display: inline-block; margin-top: 26px; padding: 12px 24px;
    border: 1.5px solid #dcdfe3; border-radius: 999px; background: #fff;
    font-size: 14px; cursor: pointer;
  }
  .bf__footer-actions { text-align: center; }
{% endstyle %}

<script>
(function () {
  var root = document.getElementById('bf-app');
  if (!root) return;

  var dataEl = root.querySelector('[data-bf-data]');
  var app = root.querySelector('[data-bf-app]');
  var progressBar = root.querySelector('[data-bf-progress]');
  if (!dataEl || !app) return;

  var DATA;
  try { DATA = JSON.parse(dataEl.textContent); }
  catch (e) { app.innerHTML = '<p style="text-align:center">Il bike finder non è disponibile al momento.</p>'; return; }

  var COLLS = DATA.collections || {};
  var WHATSAPP = {{ bf_whatsapp | json }};

  var MONEY = function (cents) {
    return '€ ' + (cents / 100).toLocaleString('it-IT', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  };

  // ---- Domande (4) ----
  var QUESTIONS = [
    {
      key: 'terreno',
      title: 'Dove pedalerai di più?',
      sub: 'Il terreno principale decide la famiglia di bici.',
      options: [
        { label: '🛣️ Asfalto / strada', value: 'strada' },
        { label: '🌾 Sterrato e misto (gravel)', value: 'gravel' },
        { label: '⛰️ Sentieri e montagna', value: 'mtb' },
        { label: '🏙️ Città, tutti i giorni', value: 'citta' }
      ]
    },
    {
      key: 'motore',
      title: 'Vuoi la pedalata assistita?',
      sub: 'Il motore aiuta su salite, distanze lunghe o per tornare in sella con più facilità.',
      options: [
        { label: '⚡ Sì, con motore', value: 'si' },
        { label: '💪 No, muscolare', value: 'no' }
      ]
    },
    {
      key: 'budget',
      title: 'Qual è il tuo budget massimo?',
      sub: 'Se non troviamo nulla entro il budget, ti mostriamo le opzioni più vicine.',
      options: [
        { label: 'Fino a 1.500 €', value: 1500 },
        { label: 'Fino a 3.000 €', value: 3000 },
        { label: 'Fino a 5.000 €', value: 5000 },
        { label: 'Oltre 5.000 €', value: 99999 }
      ]
    },
    {
      key: 'livello',
      title: 'Come ti descriveresti?',
      sub: 'Ci aiuta a scegliere la fascia giusta di componenti.',
      options: [
        { label: '😊 Sto iniziando', value: 'principiante' },
        { label: '🚴 Pedalo con regolarità', value: 'intermedio' },
        { label: '🔥 Esperto / agonista', value: 'esperto' }
      ]
    },
    {
      key: 'altezza',
      title: 'Quanto sei alto?',
      sub: 'Ti proponiamo solo bici disponibili nella taglia adatta a te.',
      options: [
        { label: 'Meno di 1,60 m', value: 'b1' },
        { label: '1,60 – 1,70 m', value: 'b2' },
        { label: '1,70 – 1,78 m', value: 'b3' },
        { label: '1,78 – 1,86 m', value: 'b4' },
        { label: '1,86 – 1,93 m', value: 'b5' },
        { label: 'Oltre 1,93 m', value: 'b6' }
      ]
    }
  ];

  // ---- Tabella altezza -> taglie (numeriche per strada/gravel, lettere per MTB/urban) ----
  var SIZE_CHART = {
    b1: { nums: [44, 47, 48, 49],     letters: ['xxs', 'xs'] },
    b2: { nums: [49, 50, 51, 52],     letters: ['xs', 's'] },
    b3: { nums: [52, 53, 54],         letters: ['s', 'm'] },
    b4: { nums: [54, 55, 56],         letters: ['m', 'l'] },
    b5: { nums: [56, 57, 58],         letters: ['l', 'xl'] },
    b6: { nums: [58, 59, 60, 61, 62], letters: ['xl', 'xxl'] }
  };

  function extractSizeTokens(str) {
    var s = (str || '').toLowerCase();
    var out = { nums: [], letters: [] };
    var nm = s.match(/\b(4[4-9]|5[0-9]|6[0-2])\b/g);
    if (nm) nm.forEach(function (n) { out.nums.push(parseInt(n, 10)); });
    var lm = s.match(/\b(xxs|xs|s|m|l|xl|xxl)\b/g);
    if (lm) lm.forEach(function (t) { if (out.letters.indexOf(t) === -1) out.letters.push(t); });
    return out;
  }

  function sizeTokensMatch(tok, chart) {
    for (var i = 0; i < tok.nums.length; i++) if (chart.nums.indexOf(tok.nums[i]) !== -1) return true;
    for (var j = 0; j < tok.letters.length; j++) if (chart.letters.indexOf(tok.letters[j]) !== -1) return true;
    return false;
  }

  // 2 = taglia giusta DISPONIBILE, 1 = taglia non indicata dal prodotto, 0 = taglie note ma nessuna adatta/disponibile
  function sizeFit(p) {
    if (!state.altezza) return 1;
    var chart = SIZE_CHART[state.altezza];
    if (!chart) return 1;
    var hasInfo = false, ok = false;
    if (p.variants && p.variants.length) {
      for (var i = 0; i < p.variants.length; i++) {
        var tok = extractSizeTokens(p.variants[i].title);
        if (tok.nums.length || tok.letters.length) {
          hasInfo = true;
          if (p.variants[i].available && sizeTokensMatch(tok, chart)) ok = true;
        }
      }
      if (ok) return 2;
      if (hasInfo) return 0;
    }
    // taglia indicata nel titolo (usato: "Tg 54", "tg M")
    var m = (p.title || '').toLowerCase().match(/\btg\.?\s*([a-z0-9]+)/);
    if (m) {
      var tok2 = extractSizeTokens(' ' + m[1] + ' ');
      if (tok2.nums.length || tok2.letters.length) return sizeTokensMatch(tok2, chart) ? 2 : 0;
    }
    return 1;
  }

  // Domanda extra mostrata SOLO quando il terreno scelto e' l'asfalto
  var GAMMA_QUESTION = {
    key: 'gamma',
    title: 'Race o Endurance?',
