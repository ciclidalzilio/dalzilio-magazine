  // Parole nel titolo che aiutano a distinguere e-road da e-gravel nella collezione unica
  function matchesTerrainHint(product) {
    if (state.terreno !== 'strada' && state.terreno !== 'gravel') return true;
    if (state.motore !== 'si') return true;
    var title = (product.title || '').toLowerCase();
