  // ---- Selezione collezione in base a terreno + motore ----
  function pickPools() {
    var t = state.terreno, m = state.motore;
    // primary: dove cercare prima. secondary: da usare se primary è scarno.
    if (t === 'strada') return m === 'si' ? { primary: ['eroad'], secondary: ['usato'] } : { primary: ['strada'], secondary: ['usato'] };
    if (t === 'gravel') return m === 'si' ? { primary: ['eroad'], secondary: ['usato'] } : { primary: ['gravel'], secondary: ['usato'] };
    if (t === 'mtb')    return m === 'si' ? { primary: ['emtb'], secondary: ['usato'] } : { primary: ['mtb'], secondary: ['usato'] };
    /* città */          return m === 'si' ? { primary: ['urban'], secondary: ['usato'] } : { primary: ['usato', 'urban'], secondary: [] };
