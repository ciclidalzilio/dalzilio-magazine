            window.productCarousels['4f51f244-5e19-44ff-b6c3-51f7337c25ec'] = { title: 'Scopri la gamma Topstone Carbon', products: [{"SalsifyId":"3892-COLL2025","ModelYear":"2025","ActiveModelYear":"2025","Platform":"Topstone Carbon","Category":"Road","Subcategory":"Gravel","ProductType":"Bike","Title":"Topstone Carbon","Subtitle":"1 Lefty AXS","ProductCardDescription":"Una bici gravel polivalente e micidiale. Doppia sospensione con Kingpin/Lefty Oliver, gruppo wireless SRAM Rival AXS/GX Eagle AXS a 12 velocità, ruote in carbonio Reserve ","FullDescription":"La nostra interpretazione della bici gravel polivalente per eccellenza. Vai ovunque, portati di tutto e poi continua a pedalare.","ModelDescription":"Progettata per i ciclisti che cercano velocità, controllo e un mezzo per gli sterrati che sia tanto piacevole quanto bello. KingPin e l’aggiornata forcella Lefty Oliver lavorano in perfetta armonia, attenuando le vibrazioni e spianando le sconnessioni per una maggiore velocità e un minor affaticamento. Sia che si tratti di una lunga pedalata o di un’uscita veloce, mantengono la bici composta e facile da guidare, consentendoti di spingerti oltre senza sprecare energie. La trasmissione wireless SRAM Rival AXS/GX Eagle AXS garantisce cambiate precise e senza sforzo, mentre le ruote Reserve 40|44 rimangono stabili e sicure su tutti i terreni. Questa bici è il punto di incontro tra gravel e maestosità. ","Tagline":"Sempre pronta","PositioningPhrase":"La nostra interpretazione della bici gravel polivalente per eccellenza. Vai ovunque, portati di tutto e poi continua a pedalare.","WhatBuiltFor":"","WhatItFor":"Uscite e gare gravel, bikepacking, esplorazione di sentieri, andare oltre l’asfalto ","WhereItThrives":"","FeatureComps":["Leggero telaio full carbon con sospensione posteriore Kingpin, costruzione Proportional Response specifica per taglia e vano portaoggetti StashPort nel tubo obliquo  ","Lefty Oliver: la nostra incredibile forcella ammortizzata progettata per il gravel. Prestazioni precise, fluide e controllate su qualsiasi superficie ","Un potente mix dei gruppi elettronici wireless SRAM Rival AXS e GX AXS a 12 velocità. Versatile trasmissione a 12 velocità monocorona, con ampia gamma di rapporti ","Ruote gravel in carbonio Reserve 40 I 44 GR leggere, resistenti e aerodinamiche, con mozzi DT-Swiss 370 e pneumatici WTB Raddler 44c ","Reggisella in carbonio Cannondale SAVE per un maggior comfort e manubrio allargato Easton EA70 AX "],"KeyTechnology":[],"OverrideMainImageUrl":"","ContainsPFAS":false,"ContainsCCBattery":true,"IsElectric":false,"Certifications":null,"IsULCertified":false,"Modified":"2026-04-14T00:42:06.817Z","ProductImageUrl":"https://embed.widencdn.net/img/dorelrl/njiiif2qsq/2000px@1x/C25_C15185U_Topstone_Crb_1_Lefty_AXS_BLK_PD.png","RetailAvailabilityHeadline":"","RetailAvailabilityMessage":"","NotificationModalID":"","MessageExpiration":"9999-12-31T23:59:59.9999999Z","ProductWordmarkImageURL":"","ProductWordmarkLink":"","FirstAvailableOn":"2025-03-10T12:00:00Z","IsValid":true,"IsValidForCommerce":true,"ColorFilter":["Black"],"Badges":[],"Variants":[{"AvailableB2C":"2025-03-10T12:00:00Z","Sku":"C15185U1047","ColorName":"Black","ColorSwatch":"BLK","ColorFilter":["Black"],"Size":"47","Upc":"196870183940","SalsifyParentId":"3892-COLL2025","MainDetailImage":"https://embed.widencdn.net/img/dorelrl/njiiif2qsq/2000px@1x/C25_C15185U_Topstone_Crb_1_Lefty_AXS_BLK_PD.png","ProductImage3Q":"https://embed.widencdn.net/img/dorelrl/f2ve8ze2eq/2000px@1x/C25_C15185U_Topstone_Crb_1_Lefty_AXS_BLK_3Q.png","DetailImages":["https://embed.widencdn.net/img/dorelrl/njiiif2qsq/2000px@1x/C25_C15185U_Topstone_Crb_1_Lefty_AXS_BLK_PD.png","https://embed.widencdn.net/img/dorelrl/f2ve8ze2eq/2000px@1x/C25_C15185U_Topstone_Crb_1_Lefty_AXS_BLK_3Q.png","https://embed.widencdn.net/img/dorelrl/csxhrlgzzw/2000px@1x/C25_C15185U_Topstone_Crb_1_Lefty_AXS_BLK_D1.png","https://embed.widencdn.net/img/dorelrl/q0bvkqso7y/2000px@1x/C25_C15185U_Topstone_Cr