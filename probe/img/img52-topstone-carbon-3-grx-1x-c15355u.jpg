bon 1 Lefty AXS","RelativeUrl":"/it-it/bikes/road/gravel/topstone-carbon/topstone-carbon-1-lefty-axs","Language":"it-IT","Id":"50e3c0f3-e50f-4b91-2bf3-41aeb8123e76"},{"SalsifyId":"3884-COLL2025","ModelYear":"2025","ActiveModelYear":"2025","Platform":"Topstone Carbon","Category":"Road","Subcategory":"Gravel","ProductType":"Bike","Title":"Topstone Carbon","Subtitle":"2 GRX - 2x","ProductCardDescription":"Una bici gravel con sospensione posteriore, veloce e scorrevole. Leggero telaio in carbonio con sospensione Kingpin, gruppo Shimano GRX 820, e cerchi WTB KOM","FullDescription":"La nostra interpretazione della bici gravel polivalente per eccellenza. Vai ovunque, portati di tutto e poi continua a pedalare.","ModelDescription":"Il coltellino svizzero delle bici gravel. La trasmissione Shimano GRX820 è in grado di gestire sia le uscite del fine settimana così come gli sprint nei giorni di gara. La sospensione KingPin ti mantiene comodo e ancorato al terreno, in qualsiasi condizione. Grazie allo spazio per pneumatici larghi e tutti i supporti di cui hai bisogno, questa bici è pronta per qualsiasi avventura tu possa immaginare. Fai le valigie e parti.","Tagline":"Sempre pronta","PositioningPhrase":"La nostra interpretazione della bici gravel polivalente per eccellenza. Vai ovunque, portati di tutto e poi continua a pedalare.","WhatBuiltFor":"","WhatItFor":"Uscite e gare gravel, bikepacking, percorsi impegnativi e lunghi su sterrato o asfalto","WhereItThrives":"","FeatureComps":["Leggero telaio full carbon con sospensione posteriore Kingpin, costruzione Proportional Response specifica per taglia e vano portaoggetti StashPort nel tubo obliquo ","Cambiata fluida e affidabile grazie alla trasmissione GRX820 2x12 velocità di Shimano, il loro gruppo gravel meccanico top di gamma","Ruote leggere e veloci: cerchi WTB KOM Team, mozzi Shimano e pneumatici gravel WTB Riddler 45c","Il reggisella in carbonio 2 di Cannondale e il manubrio allargato 2 ShortDrop creano una posizione di guida confortevole"],"KeyTechnology":[],"OverrideMainImageUrl":"","ContainsPFAS":false,"ContainsCCBattery":true,"IsElectric":false,"Certifications":null,"IsULCertified":false,"Modified":"2026-04-14T00:42:21.88Z","ProductImageUrl":"https://embed.widencdn.net/img/dorelrl/ca3dz06qsu/2000px@1x/C25_C15155U_Topstone_Crb_2_GRX_2x_TSK_PD.png","RetailAvailabilityHeadline":"","RetailAvailabilityMessage":"","NotificationModalID":"","MessageExpiration":"9999-12-31T23:59:59.9999999Z","ProductWordmarkImageURL":"","ProductWordmarkLink":"","FirstAvailableOn":"2025-03-10T12:00:00Z","IsValid":true,"IsValidForCommerce":true,"ColorFilter":["White"],"Badges":[],"Variants":[{"AvailableB2C":"2025-03-10T12:00:00Z","Sku":"C15155U1047","ColorName":"Tiger Shark","ColorSwatch":"TSK","ColorFilter":["White"],"Size":"47","Upc":"196870183582","SalsifyParentId":"3884-COLL2025","MainDetailImage":"https://embed.widencdn.net/img/dorelrl/ca3dz06qsu/2000px@1x/C25_C15155U_Topstone_Crb_2_GRX_2x_TSK_PD.png","ProductImage3Q":"https://embed.widencdn.net/img/dorelrl/knseh74pgg/2000px@1x/C25_C15155U_Topstone_Crb_2_GRX_2x_TSK_3Q.png","DetailImages":["https://embed.widencdn.net/img/dorelrl/ca3dz06qsu/2000px@1x/C25_C15155U_Topstone_Crb_2_GRX_2x_TSK_PD.png","https://embed.widencdn.net/img/dorelrl/knseh74pgg/2000px@1x/C25_C15155U_Topstone_Crb_2_GRX_2x_TSK_3Q.png","https://embed.widencdn.net/img/dorelrl/yztjq9gozd/2000px@1x/C25_C15155U_Topstone_Crb_2_GRX_2x_TSK_D1.png","https://embed.widencdn.net/img/dorelrl/ubrchtsxop/2000px@1x/C25_C15155U_Topstone_Crb_2_GRX_2x_TSK_D2.png","https://embed.widencdn.net/img/dorelrl/3c3u9m4nov/2000px@1x/C25_C15155U_Topstone_Crb_2_GRX_2x_TSK_D3.png","https://embed.widencdn.net/img/dorelrl/xferuziddn/2000px@1x/C25_C15155U_Topstone_Crb_2_GRX_2x_TSK_D5.png","https://embed.widencdn.net/img/dorelrl/w8pfvnxz5x/2000px@1x/C25_C15155U_Topstone_Crb_2_GRX_2x_TSK_D6.png"],"PageTheme":null,"BackgroundColor":"#FBFBFA","Prices":[{"Sku":"C15155U1047","SoldTo":null,"Msrp":3699.0,"SalePrice":0.0,"State":0,